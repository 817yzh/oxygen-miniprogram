/* pages/mood-scan/mood-scan.wxss · 面部能量扫描仪（杂志高定风 · Grade A） */

/* ===== 全屏沉浸：极光薄荷渐变底（告别死白） ===== */
.ms-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EAF4F0 0%, #D9EDE5 42%, #C8E4DA 100%);
  padding: 0 0;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.btn-hover { transform: scale(0.97); opacity: 0.9; }

/* ===== 极光光晕层（通透呼吸感） ===== */
.ms-aura {
  position: fixed;
  border-radius: 50%;
  filter: blur(70rpx);
  pointer-events: none;
  z-index: 0;
}
.aura-1 {
  width: 600rpx; height: 600rpx;
  left: -160rpx; top: -120rpx;
  background: radial-gradient(circle, rgba(96,205,180,0.5), transparent 72%);
  animation: auraFloat 9s ease-in-out infinite;
}
.aura-2 {
  width: 540rpx; height: 540rpx;
  right: -150rpx; top: 22%;
  background: radial-gradient(circle, rgba(255,252,240,0.85), transparent 72%);
  animation: auraFloat 12s ease-in-out infinite reverse;
}
.aura-3 {
  width: 680rpx; height: 680rpx;
  left: 18%; bottom: -180rpx;
  background: radial-gradient(circle, rgba(120,224,200,0.4), transparent 72%);
  animation: auraFloat 14s ease-in-out infinite;
}
@keyframes auraFloat {
  0%,100% { transform: translate(0,0) scale(1); opacity: 0.9; }
  50% { transform: translate(26rpx,-30rpx) scale(1.07); opacity: 0.55; }
}
/* 细腻噪点（杂志纸感） */
.ms-grain {
  position: fixed; inset: 0;
  background-image: radial-gradient(rgba(20,60,50,0.05) 1px, transparent 1px);
  background-size: 22rpx 22rpx;
  opacity: 0.55;
  pointer-events: none; z-index: 0;
}

/* ========== STEP 0 · 杂志高定排版 ========== */
.ms-scan {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center;
  position: relative; z-index: 1;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* 顶部 · 艺术展览级大排版标题 */
.ms-hero {
  width: 100%;
  display: flex; flex-direction: column; align-items: center;
  margin-top: 100rpx;
}
.ms-hero-title {
  font-size: 54rpx; font-weight: 800;
  color: #123C33; letter-spacing: 6rpx;
  text-shadow: 0 2rpx 0 rgba(255,255,255,0.6);
}
.ms-hero-sub {
  margin-top: 14rpx;
  font-size: 19rpx;
  color: #7BA294;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
.ms-hero-divider {
  width: 120rpx; height: 2rpx;
  margin-top: 34rpx;
  background: linear-gradient(90deg, transparent, rgba(30,142,111,0.5), transparent);
}
.ms-hero-cn {
  margin-top: 20rpx;
  font-size: 24rpx; color: #3F6B5E;
  letter-spacing: 6rpx;
}

/* 核心 · 毛玻璃水晶浮岛 */
.ms-stage {
  width: 560rpx; height: 620rpx;
  margin: 30rpx auto 0;
  position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
/* 呼吸薄荷光晕（代替生硬线条） */
.ms-halo {
  position: absolute; top: 50%; left: 50%;
  width: 480rpx; height: 480rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114,216,196,0.28), transparent 68%);
  filter: blur(10rpx);
  animation: haloBreathe 3.2s ease-in-out infinite;
}
.halo-sm { width: 360rpx; height: 360rpx; top: 40%; }
@keyframes haloBreathe {
  0%,100% { transform: translate(-50%,-50%) scale(0.92); opacity: 0.6; }
  50% { transform: translate(-50%,-50%) scale(1.1); opacity: 1; }
}
/* 轻微扫描扇束（科技感保留，极淡） */
.ms-radar {
  position: absolute; top: 50%; left: 50%;
  width: 460rpx; height: 460rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: conic-gradient(from 0deg,
    rgba(96,205,180,0) 0deg,
    rgba(96,205,180,0.05) 45deg,
    rgba(163,230,214,0.28) 85deg,
    transparent 105deg);
  animation: radarSpin 3.4s linear infinite;
}
.ms-radar-faint {
  position: absolute; top: 50%; left: 50%;
  width: 460rpx; height: 460rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: conic-gradient(from 0deg,
    rgba(163,230,214,0) 0deg,
    rgba(163,230,214,0.04) 55deg,
    rgba(163,230,214,0.14) 95deg,
    transparent 118deg);
  animation: radarSpin 3.4s linear infinite;
  animation-delay: 0.6s;
}
@keyframes radarSpin { from { transform: translate(-50%,-50%) rotate(0deg); } to { transform: translate(-50%,-50%) rotate(360deg); } }

/* 毛玻璃浮岛卡片（Glassmorphism） */
.ms-glass-card {
  position: relative;
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.60);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  border: 1.5rpx solid rgba(255,255,255,0.75);
  box-shadow:
    0 24rpx 50rpx rgba(40,116,90,0.10),
    inset 0 0 20rpx rgba(255,255,255,0.75),
    inset 0 -10rpx 26rpx rgba(114,216,196,0.25);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  z-index: 2;
}
/* 左上高光饰面 */
.ms-glass-shine {
  position: absolute; inset: 0; border-radius: 50%;
  background: radial-gradient(circle at 32% 24%, rgba(255,255,255,0.85), transparent 44%);
  pointer-events: none; z-index: 2;
}
.ms-glass-photo { width: 100%; height: 100%; border-radius: 50%; position: relative; z-index: 1; }
.ms-glass-fox {
  display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 3;
  width: 100%; height: 100%;
}
.ms-glass-fox-ico {
  font-size: 132rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(30,142,111,0.30));
}
.fox-breathe { animation: foxBreathe 2.4s ease-in-out infinite; }
@keyframes foxBreathe {
  0%,100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
.fox-idle { animation: foxIdle 0.4s ease; }
@keyframes foxIdle { 0% { transform: scale(0.92); } 100% { transform: scale(1); } }

/* 状态提示 · 极薄半透明药丸（紧贴浮岛下方） */
.ms-pill {
  position: relative;
  margin-top: 34rpx;
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255,255,255,0.65);
  box-shadow: 0 8rpx 22rpx rgba(40,116,90,0.08);
  z-index: 3;
}
.ms-pill-text {
  font-size: 24rpx; color: #2E5E51; font-weight: 600; letter-spacing: 1rpx;
}

/* 底部操作区（聚合，拒绝脱节） */
.ms-actions-btm {
  width: 100%;
  display: flex; flex-direction: column; align-items: center;
  margin-top: auto;
  padding-bottom: 64rpx;
  padding-top: 20rpx;
}
/* 高定主按钮（薄荷渐变 + 微光流光边框） */
.ms-primary {
  position: relative;
  width: 100%;
  height: 104rpx;
  border-radius: 32px;
  background: linear-gradient(135deg, #2EC4B6 0%, #209E92 100%);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  box-shadow:
    0 14rpx 30rpx rgba(46,196,182,0.35),
    inset 0 2rpx 0 rgba(255,255,255,0.35);
  border: 1rpx solid rgba(255,255,255,0.35);
}
.ms-primary::before {
  content: '';
  position: absolute; inset: 0;
  border-radius: 32px;
  padding: 2rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.6), transparent 40%, rgba(255,255,255,0.3));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}
.ms-primary-ico { font-size: 30rpx; margin-right: 14rpx; position: relative; z-index: 2; }
.ms-primary-text { color: #fff; font-size: 32rpx; font-weight: 700; letter-spacing: 2rpx; position: relative; z-index: 2; }
.ms-primary-glow {
  position: absolute; top: -40rpx; left: -40%;
  width: 56%; height: 200%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.35), transparent);
  transform: rotate(20deg);
  animation: primaryShine 3s ease-in-out infinite;
  z-index: 1;
}
@keyframes primaryShine {
  0% { left: -60%; } 60%,100% { left: 140%; }
}
.ms-primary--press { transform: scale(0.97); }
.ms-primary--ready { animation: primaryReady 1.6s ease-in-out infinite; }
@keyframes primaryReady {
  0%,100% { box-shadow: 0 14rpx 30rpx rgba(46,196,182,0.35), inset 0 2rpx 0 rgba(255,255,255,0.35); }
  50% { box-shadow: 0 14rpx 42rpx rgba(46,196,182,0.5), 0 0 0 14rpx rgba(114,216,196,0.16), inset 0 2rpx 0 rgba(255,255,255,0.35); }
}

/* 副按钮（低调返回） */
.ms-skip {
  margin-top: 30rpx;
  display: flex; align-items: center;
  padding: 8rpx 14rpx;
}
.ms-skip-text { font-size: 20rpx; color: #8FB0A4; letter-spacing: 1rpx; }
.ms-skip-arrow {
  font-size: 24rpx; color: #7BA294; margin-left: 4rpx; opacity: 0.75;
  transition: transform 0.2s ease;
}
.ms-skip--press .ms-skip-arrow { transform: translateX(4rpx); opacity: 1; }

/* ===== STEP 1 · 识别中（毛玻璃浮岛 + 沉浸文案） ===== */
.ms-analyzing {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  position: relative; z-index: 1;
}
.glass-analyzing {
  width: 240rpx; height: 240rpx;
  background: rgba(255,255,255,0.62);
}
.ms-analyzing-text { margin-top: 60rpx; font-size: 30rpx; color: #123C33; font-weight: 700; letter-spacing: 1rpx; }
.ms-analyzing-sub { margin-top: 14rpx; font-size: 21rpx; color: #7BA294; letter-spacing: 2rpx; }
.ms-analyzing-dots { display: flex; gap: 14rpx; margin-top: 34rpx; }
.ms-analyzing-dots .dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #2BA882; animation: dotB 1.2s infinite; }
.ms-analyzing-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.ms-analyzing-dots .dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotB { 0%,100% { opacity: 0.3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-10rpx); } }

/* ===== STEP 2 结果 ===== */
.ms-result { padding: 40rpx 48rpx 60rpx; position: relative; z-index: 1; }
.ms-result-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.ms-result-tag { font-size: 30rpx; font-weight: 700; color: #21453C; }
.ms-band {
  border-radius: 36rpx; padding: 40rpx 34rpx;
  display: flex; flex-direction: column; align-items: center;
  position: relative; overflow: hidden; box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.08);
}
.ms-band-emoji { font-size: 90rpx; }
.ms-band-name { margin-top: 16rpx; font-size: 40rpx; font-weight: 800; color: #21453C; letter-spacing: 2rpx; }
.ms-band-desc { margin-top: 14rpx; font-size: 26rpx; color: #3F5A52; text-align: center; line-height: 1.6; }
.ms-band-wave { display: flex; align-items: center; gap: 10rpx; margin-top: 24rpx; }
.ms-band-wave .wave { width: 40rpx; border-radius: 6rpx; background: rgba(255,255,255,0.7); }
.w1 { height: 24rpx; } .w2 { height: 48rpx; } .w3 { height: 32rpx; }

/* 通用卡片 */
.ms-card { background: rgba(255,255,255,0.85); border-radius: 30rpx; padding: 30rpx; margin-top: 24rpx; box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.04); }
.ms-section-title { display: block; font-size: 28rpx; font-weight: 700; color: #21453C; margin-bottom: 18rpx; }
.ms-psych-text { display: block; font-size: 26rpx; color: #4A675E; line-height: 1.75; }

/* 微表情 */
.ms-micro-item { display: flex; align-items: center; margin-bottom: 18rpx; }
.ms-micro-icon { font-size: 34rpx; width: 50rpx; }
.ms-micro-label { font-size: 24rpx; color: #718C84; width: 130rpx; }
.ms-micro-bar { flex: 1; height: 16rpx; background: #EAF3EF; border-radius: 8rpx; overflow: hidden; margin: 0 16rpx; }
.ms-micro-fill { height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #72D8C4, #2BA882); transition: width 0.8s ease; }
.ms-micro-val { font-size: 24rpx; font-weight: 700; color: #21453C; width: 60rpx; text-align: right; }

.ms-meter-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.ms-meter { flex: 1; background: rgba(255,255,255,0.85); border-radius: 26rpx; padding: 24rpx; box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.04); }
.ms-meter-top { display: flex; justify-content: space-between; font-size: 24rpx; color: #8BA89F; margin-bottom: 14rpx; }
.ms-meter-num { font-weight: 700; color: #21453C; }
.ms-meter-bg { height: 18rpx; background: #EAF3EF; border-radius: 10rpx; overflow: hidden; }
.ms-meter-fill { height: 100%; border-radius: 10rpx; transition: width 0.8s ease; }
.joy { background: linear-gradient(90deg, #FFD28A, #FF9E5E); }
.oxy { background: linear-gradient(90deg, #7FD1F5, #38A9E8); }
.risk { background: linear-gradient(90deg, #FF9A8B, #FF5E72); }

/* 维度四 · 彩蛋 */
.ms-egg {
  margin-top: 24rpx; border-radius: 30rpx; padding: 30rpx;
  background: linear-gradient(135deg, #2A1E4D, #4A2D7A);
  border: 2rpx solid #8B6FD8; color: #fff;
}
.egg-pop { animation: eggPop 0.6s ease; }
@keyframes eggPop { 0% { transform: scale(0.85); opacity: 0; } 60% { transform: scale(1.05); } 100% { transform: scale(1); opacity: 1; } }
.ms-egg-head { display: flex; align-items: center; justify-content: space-between; }
.ms-egg-rare { font-size: 20rpx; font-weight: 800; padding: 4rpx 14rpx; border-radius: 20rpx; }
.ms-egg-rare.R { background: #3E8BFF; }
.ms-egg-rare.SR { background: #B36BFF; }
.ms-egg-rare.SSR { background: linear-gradient(90deg,#FFB347,#FF6B6B); }
.ms-egg-title { font-size: 28rpx; font-weight: 700; }
.ms-egg-body { display: flex; flex-direction: column; align-items: center; margin-top: 20rpx; }
.ms-egg-emoji { font-size: 90rpx; }
.ms-egg-name { margin-top: 12rpx; font-size: 32rpx; font-weight: 700; }
.ms-egg-desc { margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.85); }

/* 维度二 · 文学 */
.ms-card.quote { background: linear-gradient(135deg,#FDF6EF,#FAF3E6); }
.ms-quote-text { display: block; font-size: 27rpx; color: #7A5B3A; font-weight: 600; line-height: 1.7; }
.ms-quote-warm { display: block; margin-top: 16rpx; font-size: 24rpx; color: #A5815C; line-height: 1.6; }

/* 维度三 · 天气互文 */
.ms-weather {
  margin-top: 24rpx; padding: 24rpx 26rpx; border-radius: 26rpx;
  background: rgba(240,250,255,0.9); border: 1rpx solid #D3ECF7;
  display: flex; align-items: center;
}
.ms-weather-emoji { font-size: 44rpx; margin-right: 16rpx; }
.ms-weather-text { font-size: 24rpx; color: #2B6CB0; line-height: 1.6; flex: 1; }

.ms-dual {
  margin-top: 24rpx; padding: 24rpx 26rpx; border-radius: 26rpx;
  background: #FFF8F0; border: 1rpx solid #FFE0C2;
  display: flex; align-items: center;
}
.ms-dual-emoji { font-size: 44rpx; margin-right: 16rpx; }
.ms-dual-text { font-size: 24rpx; color: #B0732C; line-height: 1.6; flex: 1; }

.ms-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.ms-btn { flex: 1; text-align: center; padding: 22rpx 0; border-radius: 40rpx; font-size: 28rpx; font-weight: 600; }
.ms-btn.ghost { background: #fff; color: #1E8E6F; border: 1.5rpx solid rgba(30,142,111,0.35); }
.ms-btn.solid { background: linear-gradient(135deg, #2BA882, #1E8E6F); color: #fff; }
.ms-actions-sub { display: flex; justify-content: center; gap: 40rpx; margin-top: 26rpx; }
.ms-link { font-size: 26rpx; color: #5A8A7C; font-weight: 600; }

/* ===== STEP 3 治愈解药卡 ===== */
.ms-card-page { padding: 50rpx 48rpx; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 1; }
.ms-card-title { font-size: 40rpx; font-weight: 700; color: #21453C; margin-bottom: 30rpx; }
.ms-card {
  width: 100%; max-width: 620rpx; border-radius: 40rpx;
  padding: 60rpx 40rpx; display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.12);
}
.ms-card-emoji { font-size: 120rpx; }
.ms-card-band { margin-top: 20rpx; font-size: 44rpx; font-weight: 800; color: #21453C; }
.ms-card-divider { width: 120rpx; height: 4rpx; background: rgba(33,69,60,0.2); border-radius: 2rpx; margin: 30rpx 0; }
.ms-card-persona { font-size: 30rpx; font-weight: 700; color: #21453C; text-align: center; }
.ms-card-psych { margin-top: 18rpx; font-size: 24rpx; color: #3F5A52; text-align: center; line-height: 1.7; }
.ms-card-quote { margin-top: 18rpx; font-size: 22rpx; color: #5A6E66; text-align: center; font-style: italic; line-height: 1.6; }
.ms-card-foot { display: flex; justify-content: space-between; align-items: center; width: 100%; margin-top: 50rpx; }
.ms-card-ip { font-size: 22rpx; color: #4A675E; font-weight: 600; }
.ms-card-date { font-size: 22rpx; color: #7A958C; }
.ms-card-hint { margin-top: 26rpx; font-size: 22rpx; color: #9FBEB3; }
