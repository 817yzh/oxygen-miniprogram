/* pages/mood-scan/mood-scan.wxss · 面部能量扫描仪（杂志高定风 · Grade A） */

/* ===== 全屏沉浸：极光薄荷渐变底（告别死白） ===== */
.ms-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EAF4F0 0%, #D9EDE5 42%, #C8E4DA 100%);
  padding: 0 0;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.btn-hover { transform: scale(0.97); opacity: 0.9; }

/* ===== 极光光晕层（通透呼吸感） ===== */
.ms-aura {
  position: fixed;
  border-radius: 50%;
  filter: blur(70rpx);
  pointer-events: none;
  z-index: 0;
}
.aura-1 {
  width: 600rpx; height: 600rpx;
  left: -160rpx; top: -120rpx;
  background: radial-gradient(circle, rgba(96,205,180,0.5), transparent 72%);
  animation: auraFloat 9s ease-in-out infinite;
}
.aura-2 {
  width: 540rpx; height: 540rpx;
  right: -150rpx; top: 22%;
  background: radial-gradient(circle, rgba(255,252,240,0.85), transparent 72%);
  animation: auraFloat 12s ease-in-out infinite reverse;
}
.aura-3 {
  width: 680rpx; height: 680rpx;
  left: 18%; bottom: -180rpx;
  background: radial-gradient(circle, rgba(120,224,200,0.4), transparent 72%);
  animation: auraFloat 14s ease-in-out infinite;
}
@keyframes auraFloat {
  0%,100% { transform: translate(0,0) scale(1); opacity: 0.9; }
  50% { transform: translate(26rpx,-30rpx) scale(1.07); opacity: 0.55; }
}
/* 细腻噪点（杂志纸感） */
.ms-grain {
  position: fixed; inset: 0;
  background-image: radial-gradient(rgba(20,60,50,0.05) 1px, transparent 1px);
  background-size: 22rpx 22rpx;
  opacity: 0.55;
  pointer-events: none; z-index: 0;
}

/* ========== STEP 0 · 杂志高定排版 ========== */
.ms-scan {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center;
  position: relative; z-index: 1;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* 顶部 · 艺术展览级大排版标题 */
.ms-hero {
  width: 100%;
  display: flex; flex-direction: column; align-items: center;
  margin-top: 100rpx;
}
.ms-hero-title {
  font-size: 54rpx; font-weight: 800;
  color: #123C33; letter-spacing: 6rpx;
  text-shadow: 0 2rpx 0 rgba(255,255,255,0.6);
}
.ms-hero-sub {
  margin-top: 14rpx;
  font-size: 19rpx;
  color: #7BA294;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
.ms-hero-divider {
  width: 120rpx; height: 2rpx;
  margin-top: 34rpx;
  background: linear-gradient(90deg, transparent, rgba(30,142,111,0.5), transparent);
}
.ms-hero-cn {
  margin-top: 20rpx;
  font-size: 24rpx; color: #3F6B5E;
  letter-spacing: 6rpx;
}

/* 核心 · 毛玻璃水晶浮岛 */
.ms-stage {
  width: 560rpx; height: 620rpx;
  margin: 30rpx auto 0;
  position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
/* 呼吸薄荷光晕（代替生硬线条） */
.ms-halo {
  position: absolute; top: 50%; left: 50%;
  width: 480rpx; height: 480rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114,216,196,0.28), transparent 68%);
  filter: blur(10rpx);
  animation: haloBreathe 3.2s ease-in-out infinite;
}
.halo-sm { width: 360rpx; height: 360rpx; top: 40%; }
@keyframes haloBreathe {
  0%,100% { transform: translate(-50%,-50%) scale(0.92); opacity: 0.6; }
  50% { transform: translate(-50%,-50%) scale(1.1); opacity: 1; }
}
/* 轻微扫描扇束（科技感保留，极淡） */
.ms-radar {
  position: absolute; top: 50%; left: 50%;
  width: 460rpx; height: 460rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: conic-gradient(from 0deg,
    rgba(96,205,180,0) 0deg,
    rgba(96,205,180,0.05) 45deg,
    rgba(163,230,214,0.28) 85deg,
    transparent 105deg);
  animation: radarSpin 3.4s linear infinite;
}
.ms-radar-faint {
  position: absolute; top: 50%; left: 50%;
  width: 460rpx; height: 460rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: conic-gradient(from 0deg,
    rgba(163,230,214,0) 0deg,
    rgba(163,230,214,0.04) 55deg,
    rgba(163,230,214,0.14) 95deg,
    transparent 118deg);
  animation: radarSpin 3.4s linear infinite;
  animation-delay: 0.6s;
}
@keyframes radarSpin { from { transform: translate(-50%,-50%) rotate(0deg); } to { transform: translate(-50%,-50%) rotate(360deg); } }

/* 毛玻璃浮岛卡片 —— 参考图自带玻璃圆环，此处做圆形透明容器 */
.ms-glass-card {
  position: relative;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: transparent;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  z-index: 2;
  box-shadow: 0 20rpx 50rpx rgba(20,80,65,0.25);
}
/* 左上高光饰面（参考图已有光效，弱化） */
.ms-glass-shine {
  position: absolute; inset: 0; border-radius: 50%;
  background: radial-gradient(circle at 30% 22%, rgba(255,255,255,0.25), transparent 40%);
  pointer-events: none; z-index: 2;
}
.ms-glass-photo { width: 100%; height: 100%; border-radius: 50%; position: relative; z-index: 1; }
.ms-glass-fox {
  display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 3;
  width: 100%; height: 100%;
}
.ms-glass-fox-img {
  width: 100%;
  height: 100%;
}
.fox-breathe { animation: foxBreathe 2.4s ease-in-out infinite; }
@keyframes foxBreathe {
  0%,100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}
.fox-idle { animation: foxIdle 0.4s ease; }
@keyframes foxIdle { 0% { transform: scale(0.92); } 100% { transform: scale(1); } }

/* 状态提示 · 极薄半透明药丸（紧贴浮岛下方） */
.ms-pill {
  position: relative;
  margin-top: 34rpx;
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255,255,255,0.65);
  box-shadow: 0 8rpx 22rpx rgba(40,116,90,0.08);
  z-index: 3;
}
.ms-pill-text {
  font-size: 24rpx; color: #2E5E51; font-weight: 600; letter-spacing: 1rpx;
}

/* 底部操作区（聚合，拒绝脱节） */
.ms-actions-btm {
  width: 100%;
  display: flex; flex-direction: column; align-items: center;
  margin-top: auto;
  padding-bottom: 64rpx;
  padding-top: 20rpx;
}
/* 高定主按钮（薄荷渐变 + 微光流光边框） */
.ms-primary {
  position: relative;
  width: 100%;
  height: 104rpx;
  border-radius: 32px;
  background: linear-gradient(135deg, #2EC4B6 0%, #209E92 100%);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  box-shadow:
    0 14rpx 30rpx rgba(46,196,182,0.35),
    inset 0 2rpx 0 rgba(255,255,255,0.35);
  border: 1rpx solid rgba(255,255,255,0.35);
}
.ms-primary::before {
  content: '';
  position: absolute; inset: 0;
  border-radius: 32px;
  padding: 2rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.6), transparent 40%, rgba(255,255,255,0.3));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}
.ms-primary-ico { font-size: 30rpx; margin-right: 14rpx; position: relative; z-index: 2; }
.ms-primary-text { color: #fff; font-size: 32rpx; font-weight: 700; letter-spacing: 2rpx; position: relative; z-index: 2; }
.ms-primary-glow {
  position: absolute; top: -40rpx; left: -40%;
  width: 56%; height: 200%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.35), transparent);
  transform: rotate(20deg);
  animation: primaryShine 3s ease-in-out infinite;
  z-index: 1;
}
@keyframes primaryShine {
  0% { left: -60%; } 60%,100% { left: 140%; }
}
.ms-primary--press { transform: scale(0.97); }
.ms-primary--ready { animation: primaryReady 1.6s ease-in-out infinite; }
@keyframes primaryReady {
  0%,100% { box-shadow: 0 14rpx 30rpx rgba(46,196,182,0.35), inset 0 2rpx 0 rgba(255,255,255,0.35); }
  50% { box-shadow: 0 14rpx 42rpx rgba(46,196,182,0.5), 0 0 0 14rpx rgba(114,216,196,0.16), inset 0 2rpx 0 rgba(255,255,255,0.35); }
}

/* 副按钮（低调返回） */
.ms-skip {
  margin-top: 30rpx;
  display: flex; align-items: center;
  padding: 8rpx 14rpx;
}
.ms-skip-text { font-size: 20rpx; color: #8FB0A4; letter-spacing: 1rpx; }
.ms-skip-arrow {
  font-size: 24rpx; color: #7BA294; margin-left: 4rpx; opacity: 0.75;
  transition: transform 0.2s ease;
}
.ms-skip--press .ms-skip-arrow { transform: translateX(4rpx); opacity: 1; }

/* ===== STEP 1 · 识别中（毛玻璃浮岛 + 沉浸文案） ===== */
.ms-analyzing {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  position: relative; z-index: 1;
}
.glass-analyzing {
  width: 360rpx; height: 360rpx;
  background: transparent;
  box-shadow: 0 16rpx 40rpx rgba(20,80,65,0.25);
}
.ms-analyzing-text { margin-top: 60rpx; font-size: 30rpx; color: #123C33; font-weight: 700; letter-spacing: 1rpx; }
.ms-analyzing-sub { margin-top: 14rpx; font-size: 21rpx; color: #7BA294; letter-spacing: 2rpx; }
.ms-analyzing-dots { display: flex; gap: 14rpx; margin-top: 34rpx; }
.ms-analyzing-dots .dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #2BA882; animation: dotB 1.2s infinite; }
.ms-analyzing-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.ms-analyzing-dots .dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotB { 0%,100% { opacity: 0.3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-10rpx); } }

/* ===== STEP 2 结果 ===== */
.ms-result { padding: 40rpx 48rpx 60rpx; position: relative; z-index: 1; }
.ms-result-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.ms-result-tag { font-size: 30rpx; font-weight: 700; color: #21453C; }
.ms-band {
  border-radius: 36rpx; padding: 40rpx 34rpx;
  display: flex; flex-direction: column; align-items: center;
  position: relative; overflow: hidden; box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.08);
}
.ms-band-emoji { font-size: 90rpx; }
.ms-band-name { margin-top: 16rpx; font-size: 40rpx; font-weight: 800; color: #21453C; letter-spacing: 2rpx; }
.ms-band-desc { margin-top: 14rpx; font-size: 26rpx; color: #3F5A52; text-align: center; line-height: 1.6; }
.ms-band-wave { display: flex; align-items: center; gap: 10rpx; margin-top: 24rpx; }
.ms-band-wave .wave { width: 40rpx; border-radius: 6rpx; background: rgba(255,255,255,0.7); }
.w1 { height: 24rpx; } .w2 { height: 48rpx; } .w3 { height: 32rpx; }

/* 通用卡片 */
.ms-card { background: rgba(255,255,255,0.85); border-radius: 30rpx; padding: 30rpx; margin-top: 24rpx; box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.04); }
.ms-section-title { display: block; font-size: 28rpx; font-weight: 700; color: #21453C; margin-bottom: 18rpx; }
.ms-psych-text { display: block; font-size: 26rpx; color: #4A675E; line-height: 1.75; }

/* 微表情 */
.ms-micro-item { display: flex; align-items: center; margin-bottom: 18rpx; }
.ms-micro-icon { font-size: 34rpx; width: 50rpx; }
.ms-micro-label { font-size: 24rpx; color: #718C84; width: 130rpx; }
.ms-micro-bar { flex: 1; height: 16rpx; background: #EAF3EF; border-radius: 8rpx; overflow: hidden; margin: 0 16rpx; }
.ms-micro-fill { height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #72D8C4, #2BA882); transition: width 0.8s ease; }
.ms-micro-val { font-size: 24rpx; font-weight: 700; color: #21453C; width: 60rpx; text-align: right; }

.ms-meter-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.ms-meter { flex: 1; background: rgba(255,255,255,0.85); border-radius: 26rpx; padding: 24rpx; box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.04); }
.ms-meter-top { display: flex; justify-content: space-between; font-size: 24rpx; color: #8BA89F; margin-bottom: 14rpx; }
.ms-meter-num { font-weight: 700; color: #21453C; }
.ms-meter-bg { height: 18rpx; background: #EAF3EF; border-radius: 10rpx; overflow: hidden; }
.ms-meter-fill { height: 100%; border-radius: 10rpx; transition: width 0.8s ease; }
.joy { background: linear-gradient(90deg, #FFD28A, #FF9E5E); }
.oxy { background: linear-gradient(90deg, #7FD1F5, #38A9E8); }
.risk { background: linear-gradient(90deg, #FF9A8B, #FF5E72); }

/* 维度四 · 彩蛋 */
.ms-egg {
  margin-top: 24rpx; border-radius: 30rpx; padding: 30rpx;
  background: linear-gradient(135deg, #2A1E4D, #4A2D7A);
  border: 2rpx solid #8B6FD8; color: #fff;
}
.egg-pop { animation: eggPop 0.6s ease; }
@keyframes eggPop { 0% { transform: scale(0.85); opacity: 0; } 60% { transform: scale(1.05); } 100% { transform: scale(1); opacity: 1; } }
.ms-egg-head { display: flex; align-items: center; justify-content: space-between; }
.ms-egg-rare { font-size: 20rpx; font-weight: 800; padding: 4rpx 14rpx; border-radius: 20rpx; }
.ms-egg-rare.R { background: #3E8BFF; }
.ms-egg-rare.SR { background: #B36BFF; }
.ms-egg-rare.SSR { background: linear-gradient(90deg,#FFB347,#FF6B6B); }
.ms-egg-title { font-size: 28rpx; font-weight: 700; }
.ms-egg-body { display: flex; flex-direction: column; align-items: center; margin-top: 20rpx; }
.ms-egg-emoji { font-size: 90rpx; }
.ms-egg-name { margin-top: 12rpx; font-size: 32rpx; font-weight: 700; }
.ms-egg-desc { margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.85); }

/* 维度二 · 文学 */
.ms-card.quote { background: linear-gradient(135deg,#FDF6EF,#FAF3E6); }
.ms-quote-text { display: block; font-size: 27rpx; color: #7A5B3A; font-weight: 600; line-height: 1.7; }
.ms-quote-warm { display: block; margin-top: 16rpx; font-size: 24rpx; color: #A5815C; line-height: 1.6; }

/* 维度三 · 天气互文 */
.ms-weather {
  margin-top: 24rpx; padding: 24rpx 26rpx; border-radius: 26rpx;
  background: rgba(240,250,255,0.9); border: 1rpx solid #D3ECF7;
  display: flex; align-items: center;
}
.ms-weather-emoji { font-size: 44rpx; margin-right: 16rpx; }
.ms-weather-text { font-size: 24rpx; color: #2B6CB0; line-height: 1.6; flex: 1; }

.ms-dual {
  margin-top: 24rpx; padding: 24rpx 26rpx; border-radius: 26rpx;
  background: #FFF8F0; border: 1rpx solid #FFE0C2;
  display: flex; align-items: center;
}
.ms-dual-emoji { font-size: 44rpx; margin-right: 16rpx; }
.ms-dual-text { font-size: 24rpx; color: #B0732C; line-height: 1.6; flex: 1; }

.ms-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.ms-btn { flex: 1; text-align: center; padding: 22rpx 0; border-radius: 40rpx; font-size: 28rpx; font-weight: 600; }
.ms-btn.ghost { background: #fff; color: #1E8E6F; border: 1.5rpx solid rgba(30,142,111,0.35); }
.ms-btn.solid { background: linear-gradient(135deg, #2BA882, #1E8E6F); color: #fff; }
.ms-actions-sub { display: flex; justify-content: center; gap: 40rpx; margin-top: 26rpx; }
.ms-link { font-size: 26rpx; color: #5A8A7C; font-weight: 600; }

/* ===== STEP 3 治愈解药卡 ===== */
.ms-card-page { padding: 50rpx 48rpx; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 1; }
.ms-card-title { font-size: 40rpx; font-weight: 700; color: #21453C; margin-bottom: 30rpx; }
.ms-card {
  width: 100%; max-width: 620rpx; border-radius: 40rpx;
  padding: 60rpx 40rpx; display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.12);
}
.ms-card-emoji { font-size: 120rpx; }
.ms-card-band { margin-top: 20rpx; font-size: 44rpx; font-weight: 800; color: #21453C; }
.ms-card-divider { width: 120rpx; height: 4rpx; background: rgba(33,69,60,0.2); border-radius: 2rpx; margin: 30rpx 0; }
.ms-card-persona { font-size: 30rpx; font-weight: 700; color: #21453C; text-align: center; }
.ms-card-psych { margin-top: 18rpx; font-size: 24rpx; color: #3F5A52; text-align: center; line-height: 1.7; }
.ms-card-quote { margin-top: 18rpx; font-size: 22rpx; color: #5A6E66; text-align: center; font-style: italic; line-height: 1.6; }
.ms-card-foot { display: flex; justify-content: space-between; align-items: center; width: 100%; margin-top: 50rpx; }
.ms-card-ip { font-size: 22rpx; color: #4A675E; font-weight: 600; }
.ms-card-date { font-size: 22rpx; color: #7A958C; }
.ms-card-hint { margin-top: 26rpx; font-size: 22rpx; color: #9FBEB3; }

/* ================================================================
   扫描动效（三阶段：点击爆发 → 沉浸扫描 → 高光闪光）
   ================================================================ */

/* ===== 第二阶段：扫描能量外环（高速旋转） ===== */
.scan-ring {
  position: absolute;
  top: 50%; left: 50%;
  width: 460rpx; height: 460rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: conic-gradient(from 0deg,
    rgba(114,216,196,0.9) 0deg,
    rgba(255,255,255,0.15) 60deg,
    transparent 120deg,
    rgba(114,216,196,0.5) 240deg,
    transparent 300deg);
  -webkit-mask: radial-gradient(circle, transparent 66%, #000 67%, #000 72%, transparent 73%);
  mask: radial-gradient(circle, transparent 66%, #000 67%, #000 72%, transparent 73%);
  animation: ringSpin 1.0s linear infinite;
  z-index: 1;
  pointer-events: none;
}
.scan-ring-2 {
  width: 440rpx; height: 440rpx;
  background: conic-gradient(from 180deg,
    rgba(180,240,225,0.7) 0deg,
    transparent 90deg,
    rgba(114,216,196,0.4) 180deg,
    transparent 270deg);
  animation: ringSpinReverse 1.6s linear infinite;
}
@keyframes ringSpin {
  from { transform: translate(-50%,-50%) rotate(0deg); }
  to { transform: translate(-50%,-50%) rotate(360deg); }
}
@keyframes ringSpinReverse {
  from { transform: translate(-50%,-50%) rotate(360deg); }
  to { transform: translate(-50%,-50%) rotate(0deg); }
}

/* ===== 第二阶段：声纳波纹（从中心向外扩散） ===== */
.sonar-wave {
  position: absolute;
  top: 50%; left: 50%;
  width: 200rpx; height: 200rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  border: 2rpx solid rgba(114,216,196,0.45);
  animation: sonarExpand 1.5s ease-out infinite;
  z-index: 0;
  pointer-events: none;
}
.sonar-2 {
  animation-delay: 0.75s;
  border-color: rgba(180,240,225,0.35);
}
@keyframes sonarExpand {
  0% { width: 200rpx; height: 200rpx; opacity: 0.7; }
  100% { width: 500rpx; height: 500rpx; opacity: 0; }
}

/* ===== 第二阶段：发光扫描线（从上扫到下，3秒） ===== */
.scan-line {
  position: absolute;
  left: 8%;
  width: 84%;
  height: 6rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(114,216,196,0.85) 20%,
    rgba(255,255,255,0.95) 50%,
    rgba(114,216,196,0.85) 80%,
    transparent);
  border-radius: 6rpx;
  box-shadow:
    0 0 16rpx rgba(114,216,196,0.9),
    0 0 40rpx rgba(114,216,196,0.5),
    0 0 80rpx rgba(114,216,196,0.25);
  top: 5%;
  animation: scanMove 3s linear forwards;
  z-index: 6;
  pointer-events: none;
}
@keyframes scanMove {
  0% { top: 6%; opacity: 0; }
  5% { opacity: 1; }
  95% { opacity: 1; }
  100% { top: 92%; opacity: 0; }
}

/* ===== 第二阶段：气泡粒子（扫描线经过处上浮） ===== */
.scan-bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%,
    rgba(255,255,255,0.95),
    rgba(114,216,196,0.4) 60%,
    transparent);
  z-index: 5;
  pointer-events: none;
  animation: bubbleRise 1.8s ease-in infinite;
}
.b1 { width: 14rpx; height: 14rpx; left: 22%; top: 55%; animation-delay: 0.2s; }
.b2 { width: 10rpx; height: 10rpx; left: 68%; top: 45%; animation-delay: 0.6s; }
.b3 { width: 18rpx; height: 18rpx; left: 40%; top: 65%; animation-delay: 1.0s; }
.b4 { width: 8rpx; height: 8rpx; left: 78%; top: 58%; animation-delay: 1.4s; }
@keyframes bubbleRise {
  0% { transform: translateY(0) scale(0.4); opacity: 0; }
  15% { opacity: 0.9; }
  100% { transform: translateY(-160rpx) scale(1.1); opacity: 0; }
}

/* ===== 第三阶段：结束高光闪光（暖金全屏） ===== */
.scan-flash {
  position: fixed;
  inset: 0;
  background: radial-gradient(circle at 50% 45%,
    rgba(255,240,200,0.95) 0%,
    rgba(255,220,150,0.6) 30%,
    rgba(255,255,255,0.3) 60%,
    transparent 100%);
  z-index: 999;
  animation: flashOut 0.55s ease-out forwards;
  pointer-events: none;
}
@keyframes flashOut {
  0% { opacity: 0; }
  25% { opacity: 1; }
  100% { opacity: 0; }
}

/* ===== 第一阶段：按钮水波纹 ===== */
.ms-primary .ripple {
  position: absolute;
  top: 50%; left: 50%;
  width: 120rpx; height: 120rpx;
  margin-top: -60rpx; margin-left: -60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  transform: scale(0);
  animation: rippleExpand 0.6s ease-out forwards;
  pointer-events: none;
  z-index: 3;
}
@keyframes rippleExpand {
  0% { transform: scale(0); opacity: 0.8; }
  100% { transform: scale(5); opacity: 0; }
}

/* ===== 狐狸状态动画 ===== */
/* 扫描中：闭眼思考（微暗 + 轻微收缩） */
.fox-thinking {
  animation: foxThinking 2.6s ease-in-out;
}
@keyframes foxThinking {
  0%, 100% { filter: brightness(1); transform: scale(1); }
  15%, 85% { filter: brightness(0.78) contrast(1.1) saturate(0.9); transform: scale(0.96); }
}
/* 扫描结束：清醒弹跳（元气微笑） */
.fox-awake {
  animation: foxAwake 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.3);
}
@keyframes foxAwake {
  0% { transform: scale(0.75); filter: brightness(1.3); }
  50% { transform: scale(1.15); filter: brightness(1.1); }
  100% { transform: scale(1); filter: brightness(1); }
}

/* ================================================================
   STEP 1 识别中 · 沉浸扫描专用样式（无限循环版）
   ================================================================ */

/* STEP1 能量环尺寸适配（glass-analyzing 为 360rpx） */
.a1-ring {
  width: 420rpx; height: 420rpx;
  top: 40%; /* 与毛玻璃卡片对齐（卡片在 flex 布局中偏上） */
}
.a1-ring-2 {
  width: 400rpx; height: 400rpx;
  top: 40%;
}

/* STEP1 声纳波纹位置对齐 */
.ms-analyzing .sonar-wave {
  top: 40%;
}

/* 来回扫描线（无限循环：上→下→上） */
.scan-line-loop {
  animation: scanMoveLoop 2.8s ease-in-out infinite;
}
@keyframes scanMoveLoop {
  0% { top: 6%; opacity: 0; }
  6% { opacity: 1; }
  44% { top: 90%; opacity: 1; }
  50% { top: 92%; opacity: 0; }
  56% { top: 90%; opacity: 0; }
  60% { opacity: 1; }
  96% { top: 8%; opacity: 1; }
  100% { top: 6%; opacity: 0; }
}

/* 狐狸思考动画（无限循环：微暗→恢复） */
.fox-thinking-loop {
  animation: foxThinkingLoop 3s ease-in-out infinite;
}
@keyframes foxThinkingLoop {
  0%, 100% { filter: brightness(1); transform: scale(1); }
  50% { filter: brightness(0.78) contrast(1.1) saturate(0.9); transform: scale(0.96); }
}

/* STEP1 毛玻璃卡片确保透明 + overflow 可见（能量环在外部） */
.glass-analyzing {
  overflow: hidden;
  background: transparent;
  box-shadow: 0 16rpx 40rpx rgba(20,80,65,0.25);
}


/* ================================================================
   STEP 2 结果页 · 终极高定治愈海报（单胶囊聚合）
   ================================================================ */

.poster-page {
  min-height: 100vh;
  padding: 20rpx 28rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #EBF5F1 0%, #D4EBE3 50%, #C5E4D8 100%);
}

/* IP 破框：灵狐从右下角溢出 */
.ip-breakout {
  position: absolute;
  bottom: -30rpx;
  right: -20rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  z-index: 10;
  filter: drop-shadow(0 8rpx 20rpx rgba(40,116,90,0.25));
  pointer-events: none;
  border: 2rpx solid rgba(255,255,255,0.7);
}
.ip-breakout-img {
  width: 100%;
  height: 100%;
}

/* ---------- 顶部氛围区（极简留白 · 艺术化标题） ---------- */
.poster-header {
  text-align: center;
  padding: 36rpx 0 28rpx;
}
.poster-h-title {
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  color: #1F4A3E;
  letter-spacing: 10rpx;
  text-shadow: 0 2rpx 8rpx rgba(255,255,255,0.8);
  margin-bottom: 14rpx;
}
.poster-h-flow {
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx;
}
.flow-line {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(46,196,182,0.6));
  border-radius: 2rpx;
}
.flow-line.right {
  background: linear-gradient(90deg, rgba(46,196,182,0.6), transparent);
}
.poster-h-en {
  font-size: 18rpx;
  color: #5A8A7C;
  letter-spacing: 3rpx;
  font-weight: 500;
  font-style: italic;
  opacity: 0.85;
}

/* ---------- 核心治愈报告舱（毛玻璃解药胶囊） ---------- */
.healing-capsule {
  position: relative;
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 56rpx;
  border: 2rpx solid rgba(255,255,255,0.9);
  box-shadow:
    0 20rpx 50rpx rgba(40,116,90,0.15),
    0 8rpx 20rpx rgba(40,116,90,0.08),
    inset 0 2rpx 4rpx rgba(255,255,255,0.9),
    inset 0 -2rpx 6rpx rgba(40,116,90,0.06);
  overflow: visible;
  margin-bottom: 32rpx;
}

/* 顶部暗色流光签（独立圆角矩形） */
.capsule-head {
  position: relative;
  background: linear-gradient(135deg, #1A3D34 0%, #0D211B 100%);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 24rpx 0;
  overflow: hidden;
}
.capsule-head-glow {
  position: absolute;
  top: -80rpx; right: -60rpx;
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  opacity: 0.35;
  filter: blur(30rpx);
  pointer-events: none;
}
.capsule-head-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 18rpx;
  position: relative; z-index: 1;
}
.capsule-weather {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
  font-weight: 500;
}
.capsule-emoji {
  font-size: 48rpx;
  filter: drop-shadow(0 4rpx 10rpx rgba(0,0,0,0.2));
}
.capsule-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
  position: relative; z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}
.capsule-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.82);
  line-height: 1.6;
  font-weight: 500;
  position: relative; z-index: 1;
}

/* 中部双氧共振舱 */
.capsule-body {
  padding: 36rpx 28rpx 32rpx;
}
/* 双生能量舱（泪滴/果冻仿生形状） */
.droplets-container {
  display: flex; align-items: center; justify-content: center;
  gap: 80rpx;
  padding: 36rpx 0 24rpx;
}
.droplet-item {
  display: flex; flex-direction: column; align-items: center;
}
.liquid-droplet {
  width: 130rpx;
  height: 150rpx;
  border-radius: 50% 50% 50% 12% / 55% 55% 45% 45%;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
}
.amber-glow {
  background: radial-gradient(circle at 38% 32%, rgba(255,255,255,0.95) 0%, rgba(255,240,200,0.7) 35%, rgba(246,210,150,0.55) 70%, rgba(230,180,100,0.4) 100%);
  border: 1.5rpx solid rgba(255,255,255,0.75);
  box-shadow:
    inset 0 4rpx 12rpx rgba(255,255,255,0.8),
    inset 0 -6rpx 16rpx rgba(230,180,100,0.3),
    0 10rpx 28rpx rgba(220,160,80,0.2);
  animation: dropletBreathe 3s ease-in-out infinite;
}
.cyan-glow {
  background: radial-gradient(circle at 38% 32%, rgba(255,255,255,0.95) 0%, rgba(210,245,235,0.7) 35%, rgba(150,225,210,0.55) 70%, rgba(80,190,170,0.4) 100%);
  border: 1.5rpx solid rgba(255,255,255,0.75);
  box-shadow:
    inset 0 4rpx 12rpx rgba(255,255,255,0.8),
    inset 0 -6rpx 16rpx rgba(80,190,170,0.3),
    0 10rpx 28rpx rgba(50,160,140,0.2);
  animation: dropletBreathe 3s ease-in-out infinite 0.5s;
}
@keyframes dropletBreathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}
.droplet-num {
  font-size: 42rpx;
  font-weight: 600;
  color: #16362E;
  z-index: 1;
}
.droplet-label {
  font-size: 26rpx;
  color: #5A7E72;
  font-weight: 600;
}

/* 灵狐洞察（大引号 · 衬线手写信） */
.insight-section {
  padding: 24rpx 40rpx 20rpx;
  position: relative;
}
.insight-title-row {
  display: flex; align-items: center;
  margin-bottom: 16rpx;
}
.insight-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #16362E;
  letter-spacing: 2rpx;
}
.paw-icon {
  font-size: 24rpx;
  margin-left: 10rpx;
  opacity: 0.7;
}
.insight-quote-mark {
  font-size: 48rpx;
  color: rgba(46,196,182,0.35);
  font-family: Georgia, serif;
  line-height: 1;
}
.insight-quote-mark.open {
  display: block;
  margin-bottom: -10rpx;
}
.insight-quote-mark.close {
  display: block;
  text-align: right;
  margin-top: -10rpx;
}
.insight-text {
  display: block;
  font-size: 27rpx;
  color: #33544A;
  line-height: 1.85;
  font-family: serif;
  padding: 0 12rpx;
}

/* 心理洞察 */
.capsule-psych {
  background: rgba(114,216,196,0.08);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(114,216,196,0.15);
}
.psych-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #2EC4B6;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}
.psych-text {
  display: block;
  font-size: 24rpx;
  color: #3D6B5E;
  line-height: 1.75;
  font-weight: 500;
}

/* ---------- 底部金句（微光淡金 · 巨大留白） ---------- */
.poster-quote {
  text-align: center;
  padding: 36rpx 50rpx 40rpx;
}
.poster-quote .quote-text {
  display: block;
  font-size: 27rpx;
  color: #B8956A;
  font-style: italic;
  font-weight: 500;
  line-height: 1.9;
  margin-bottom: 14rpx;
  text-shadow: 0 1rpx 6rpx rgba(184,149,106,0.2);
}
.poster-quote .quote-warm {
  display: block;
  font-size: 21rpx;
  color: #9A7B55;
  font-weight: 500;
  opacity: 0.85;
}

/* ---------- 底部黄金双操作区（仅两个按钮 · 大呼吸感） ---------- */
.poster-actions {
  display: flex; gap: 20rpx;
  padding: 20rpx 16rpx 30rpx;
  justify-content: center;
}
.poster-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: all 0.2s ease;
}
.poster-btn.secondary {
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: #209E92;
  border: 1.5rpx solid rgba(46,196,182,0.4);
}
.poster-btn.primary {
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: #1F4A3E;
  border: 1.5rpx solid rgba(46,196,182,0.4);
  box-shadow: 0 6rpx 16rpx rgba(46,196,182,0.12);
}
.btn-hover { opacity: 0.85; transform: scale(0.97); }
