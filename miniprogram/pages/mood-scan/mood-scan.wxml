<!-- pages/mood-scan/mood-scan.wxml · 面部能量扫描仪（杂志高定风 · Grade A） -->
<view class="ms-page">

  <!-- ===== 极光呼吸光晕层（全页氛围，告别死白） ===== -->
  <view class="ms-aura aura-1"></view>
  <view class="ms-aura aura-2"></view>
  <view class="ms-aura aura-3"></view>
  <view class="ms-grain"></view>

  <!-- ===== 结束高光闪光（第三阶段） ===== -->
  <view wx:if="{{scanFlash}}" class="scan-flash"></view>

  <!-- ========== STEP 0 · 开始扫描（杂志高定排版） ========== -->
  <view wx:if="{{step === 0}}" class="ms-scan">
    <!-- 顶部 · 杂志级大排版标题 -->
    <view class="ms-hero">
      <text class="ms-hero-title">面部能量扫描</text>
      <text class="ms-hero-sub">FACIAL ENERGY SCANNING</text>
      <view class="ms-hero-divider"></view>
      <text class="ms-hero-cn">捕捉今日心灵波段</text>
    </view>

    <!-- 核心 · 毛玻璃水晶浮岛雷达 -->
    <view class="ms-stage">
      <view class="ms-halo"></view>
      <!-- 扇束光（保留轻微科技感） -->
      <view class="ms-radar"></view>
      <view class="ms-radar-faint"></view>

      <!-- ===== 扫描能量外环（第二阶段：高速旋转） ===== -->
      <view wx:if="{{scanning}}" class="scan-ring"></view>
      <view wx:if="{{scanning}}" class="scan-ring scan-ring-2"></view>

      <!-- ===== 声纳波纹（第二阶段：从中心扩散） ===== -->
      <view wx:if="{{scanning}}" class="sonar-wave"></view>
      <view wx:if="{{scanning}}" class="sonar-wave sonar-2"></view>

      <!-- 毛玻璃浮岛 -->
      <view class="ms-glass-card">
        <view class="ms-glass-shine"></view>
        <image wx:if="{{photoPath}}" class="ms-glass-photo" src="{{photoPath}}" mode="aspectFill"></image>
        <view wx:else class="ms-glass-fox {{scanning ? 'fox-thinking' : (scanDone ? 'fox-awake' : 'fox-breathe')}}">
          <image class="ms-glass-fox-img" src="/images/ip/fox-reference.webp" mode="aspectFill"></image>
        </view>
        <!-- ===== 发光扫描线（第二阶段：从上扫到下） ===== -->
        <view wx:if="{{scanning}}" class="scan-line"></view>
        <!-- ===== 气泡粒子（第二阶段：扫描线经过处上浮） ===== -->
        <view wx:if="{{scanning}}" class="scan-bubble b1"></view>
        <view wx:if="{{scanning}}" class="scan-bubble b2"></view>
        <view wx:if="{{scanning}}" class="scan-bubble b3"></view>
        <view wx:if="{{scanning}}" class="scan-bubble b4"></view>
      </view>
      <!-- 状态提示 · 紧贴浮岛下方的极薄药丸 -->
      <view class="ms-pill">
        <text class="ms-pill-text">{{scanTips[scanTipIdx]}}</text>
      </view>
    </view>

    <!-- 底部操作区 · 主按钮 + 低调返回 -->
    <view class="ms-actions-btm">
      <view class="ms-primary {{scanDone ? 'ms-primary--ready' : ''}}" bindtap="startScan" hover-class="ms-primary--press">
        <view wx:if="{{btnRipple}}" class="ripple"></view>
        <text class="ms-primary-ico">{{scanDone ? '📸' : '🚀'}}</text>
        <text class="ms-primary-text">{{scanDone ? '对准镜头，拍下此刻' : '开启 3 秒充氧扫描'}}</text>
        <text class="ms-primary-glow"></text>
      </view>
      <view class="ms-skip" bindtap="goHome" hover-class="ms-skip--press">
        <text class="ms-skip-text">暂不扫描，先回首页</text>
        <text class="ms-skip-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- ========== STEP 1 · 识别中（沉浸扫描，无原生弹窗） ========== -->
  <view wx:if="{{step === 1}}" class="ms-analyzing">
    <view class="ms-aura aura-1"></view>
    <view class="ms-aura aura-2"></view>

    <!-- 扫描能量外环（无限旋转） -->
    <view class="scan-ring a1-ring"></view>
    <view class="scan-ring scan-ring-2 a1-ring-2"></view>

    <!-- 声纳波纹 -->
    <view class="sonar-wave"></view>
    <view class="sonar-wave sonar-2"></view>

    <!-- 毛玻璃浮岛 + 狐狸 -->
    <view class="ms-glass-card glass-analyzing">
      <view class="ms-glass-shine"></view>
      <view class="ms-glass-fox fox-thinking-loop">
        <image class="ms-glass-fox-img" src="/images/ip/fox-reference.webp" mode="aspectFill"></image>
      </view>
      <!-- 来回扫描线 -->
      <view class="scan-line scan-line-loop"></view>
      <!-- 气泡粒子 -->
      <view class="scan-bubble b1"></view>
      <view class="scan-bubble b2"></view>
      <view class="scan-bubble b3"></view>
      <view class="scan-bubble b4"></view>
    </view>

    <text class="ms-analyzing-text">灵狐正在读取你的心灵气象…</text>
    <text class="ms-analyzing-sub">眨眨眼，让 AI 读懂你的疲惫</text>
    <view class="ms-analyzing-dots">
      <view class="dot"></view><view class="dot"></view><view class="dot"></view>
    </view>
  </view>

  <!-- ========== STEP 2 · 结果（终极高定治愈海报 · 单胶囊聚合） ========== -->
  <view wx:if="{{step === 2 && moodBand}}" class="ms-result poster-page">

    <!-- 顶部流动感标题（今日心灵波段 + WORK AIR） -->
    <view class="poster-header">
      <text class="poster-h-title">今日 · 心灵波段</text>
      <view class="poster-h-flow">
        <view class="flow-line"></view>
        <text class="poster-h-en">WORK AIR · OXYGEN FREQUENCY</text>
        <view class="flow-line right"></view>
      </view>
    </view>

    <!-- 核心治愈报告舱（中心毛玻璃浮岛 · 解药胶囊） -->
    <view class="healing-capsule">

      <!-- IP 破框：灵狐从右下角溢出 -->
      <view class="ip-breakout">
        <image class="ip-breakout-img" src="/images/ip/fox-reference.webp" mode="aspectFill"></image>
      </view>

      <!-- 顶部暗色流光签（深墨绿 + 人格渐变色光晕） -->
      <view class="capsule-head">
        <view class="capsule-head-glow" style="background: {{moodBand.grad}};"></view>
        <view class="capsule-head-row">
          <text class="capsule-weather">🌤️ {{moodBand.name}}</text>
          <text class="capsule-emoji">{{moodBand.emoji}}</text>
        </view>
        <text class="capsule-title">今日 · {{moodBand.name}}</text>
        <text class="capsule-desc">{{moodBand.desc}}</text>
      </view>

      <!-- 双生能量舱（泪滴/果冻仿生形状 · 高定呼吸液滴） -->
      <view class="capsule-body">
        <view class="droplets-container">

          <!-- 左泪滴：心灵氧 -->
          <view class="droplet-item">
            <view class="liquid-droplet amber-glow">
              <text class="droplet-num">{{energy}}</text>
            </view>
            <text class="droplet-label">心灵氧</text>
          </view>

          <!-- 右泪滴：身体氧 -->
          <view class="droplet-item">
            <view class="liquid-droplet cyan-glow">
              <text class="droplet-num">{{oxygen}}</text>
            </view>
            <text class="droplet-label">身体氧</text>
          </view>
        </view>

        <!-- 灵狐洞察（大引号 · 衬线手写信） -->
        <view class="insight-section">
          <view class="insight-title-row">
            <text class="insight-title">灵狐洞察</text>
            <text class="paw-icon">🐾</text>
          </view>
          <text class="insight-quote-mark open">"</text>
          <text class="insight-text">{{psychText}}</text>
          <text class="insight-quote-mark close">"</text>
        </view>
      </view>
    </view>

    <!-- 底部金句（沉浸式留白 · 卡片外） -->
    <view wx:if="{{quote}}" class="poster-quote">
      <text class="quote-text">{{quote.text}}</text>
      <text class="quote-warm">{{quote.warm}}</text>
    </view>

    <!-- 灵狐彩蛋（稀有盲盒 · 保留精简） -->
    <view wx:if="{{egg && egg.type === 'talisman'}}" class="ms-egg egg-pop">
      <view class="ms-egg-head">
        <text class="ms-egg-rare {{egg.talisman.rare}}">{{egg.talisman.rare}}</text>
        <text class="ms-egg-title">✨ 灵狐送上稀有盲盒！</text>
      </view>
      <view class="ms-egg-body">
        <text class="ms-egg-emoji">{{egg.talisman.emoji}}</text>
        <text class="ms-egg-name">{{egg.talisman.name}}</text>
        <text class="ms-egg-desc">{{egg.talisman.desc}}</text>
      </view>
    </view>

    <!-- 双氧彩蛋（保留） -->
    <view wx:if="{{showDualEgg}}" class="ms-dual egg-pop">
      <text class="ms-dual-emoji">🥚</text>
      <text class="ms-dual-text">{{dualText}}</text>
    </view>

    <!-- 底部黄金双操作区（仅两个按钮 · 大呼吸感） -->
    <view class="poster-actions">
      <view class="poster-btn secondary" hover-class="btn-hover" bindtap="goCard">📤 分享今日解药</view>
      <view class="poster-btn primary" hover-class="btn-hover" bindtap="goHome">🏠 返回氧氧宝首页</view>
    </view>
  </view>


  <!-- ========== STEP 3 · 治愈解药卡 ========== -->
  <view wx:if="{{step === 3 && moodBand}}" class="ms-card-page">
    <text class="ms-card-title">今日治愈解药卡</text>
    <view class="ms-card" style="background: {{moodBand.grad}};">
      <view class="ms-card-emoji">{{moodBand.emoji}}</view>
      <text class="ms-card-band">{{moodBand.name}}</text>
      <view class="ms-card-divider"></view>
      <text class="ms-card-persona">{{moodBand.persona}}</text>
      <text class="ms-card-psych">{{psychText}}</text>
      <text class="ms-card-quote" wx:if="{{quote}}">{{quote.text}}</text>
      <view class="ms-card-foot">
        <text class="ms-card-ip">🦊 氧氧宝 · 陪你好好呼吸</text>
        <text class="ms-card-date">{{cardDate}}</text>
      </view>
    </view>
    <view class="ms-card-hint">长按卡片区域可保存 / 分享到朋友圈 · 抖音</view>
    <view class="ms-actions">
      <view class="ms-btn ghost" hover-class="btn-hover" bindtap="rescan">🔄 再扫一次</view>
      <view class="ms-btn solid" hover-class="btn-hover" bindtap="goHome">🏠 回首页</view>
    </view>
  </view>

</view>

