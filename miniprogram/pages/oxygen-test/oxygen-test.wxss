/* 含氧感自测 */
.page.otest { padding-bottom: 60px; }

/* 开始页 */
.otest-hero { padding: 30px 0 10px; }
.otest-badge {
  width: 84px; height: 84px; border-radius: 50%;
  background: linear-gradient(135deg, #72D8C4, #B8E8FF);
  font-size: 42px; box-shadow: 0 10px 30px rgba(114,216,196,0.35);
}
.otest-title { font-size: 24px; font-weight: 700; margin-top: 14px; }

.otest-dim { display: flex; flex-direction: column; gap: 12px; }
.dim-row { gap: 10px; }
.dim-icon { font-size: 20px; width: 26px; }
.dim-name { font-size: 14px; width: 72px; flex-shrink: 0; }
.dim-bar { flex: 1; height: 8px; border-radius: 999px; background: #E2F2EC; overflow: hidden; }
.dim-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #72D8C4, #B8E8FF); }

.mt-32 { margin-top: 32px; }

/* 答题页 */
.otest-progress { gap: 10px; align-items: center; }
.otest-progress-bar { flex: 1; height: 6px; border-radius: 999px; background: #E2F2EC; overflow: hidden; }
.otest-progress-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #72D8C4, #4A9E8E); transition: width 0.3s; }

.otest-q { font-size: 18px; font-weight: 700; line-height: 1.6; }

.otest-opts { display: flex; flex-direction: column; gap: 12px; }
.opt-item {
  padding: 16px; border-radius: 16px;
  background: rgba(255,255,255,0.8); border: 1.5px solid rgba(114,216,196,0.25);
  align-items: center; justify-content: space-between;
}
.opt-hover { background: rgba(114,216,196,0.12); border-color: var(--yy-primary); }
.opt-text { font-size: 15px; }
.opt-check { color: var(--yy-primary); font-size: 20px; font-weight: 700; }

.otest-nav { justify-content: flex-start; }

/* 结果页 */
.otest-result { padding: 20px 0 8px; }
.otest-big { font-size: 22px; font-weight: 700; }
.otest-ring {
  width: 140px; height: 140px; border-radius: 50%;
  margin-top: 16px; position: relative;
}
.otest-ring-inner {
  width: 108px; height: 108px; border-radius: 50%; background: #fff;
}
.otest-ring-num { font-size: 34px; font-weight: 700; color: var(--yy-primary); }

.report-dim { display: flex; flex-direction: column; gap: 10px; }
.rep-row { gap: 10px; align-items: center; }
.rep-name { width: 88px; font-size: 13px; flex-shrink: 0; }
.rep-num { width: 30px; text-align: right; }
.energy-bar { flex: 1; height: 10px; border-radius: 999px; background: #E2F2EC; overflow: hidden; }
.energy-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg,#72D8C4,#4A9E8E); }
.energy-fill.high { background: linear-gradient(90deg,#FF9F43,#FFB26B); }
.energy-fill.mid { background: linear-gradient(90deg,#72D8C4,#4A9E8E); }
.energy-fill.low { background: linear-gradient(90deg,#B8E8FF,#7AC8F0); }

.rep-top { display: block; color: var(--yy-primary); font-weight: 600; }
.rep-advice { display: block; font-size: 14px; line-height: 1.7; color: #4a5b5b; }

.otest-actions { margin-top: 8px; }
.otest-actions .btn { min-width: 140px; }
