/* Page 6 · 每日打卡页 */
.checkin { max-width: 480px; margin: 0 auto; }
.checkin-hero { padding-top: 8px; }

.tab-switch {
  background: rgba(255,255,255,0.8);
  border-radius: 999px;
  padding: 4px;
  border: 1px solid rgba(184,232,255,0.5);
}
.tab {
  flex: 1;
  height: 40px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: var(--yy-text-sub);
}
.tab.on {
  background: var(--yy-grad-primary);
  color: #FFF;
  font-weight: 600;
}

.privacy-tip { text-align: center; }

.text-input { width: 100%; padding: 12px; box-sizing: border-box; font-size: 15px; }
.ph { color: #b8cbc9; }

.photo-area { min-height: 200px; }
.photo-preview { width: 100%; height: 220px; border-radius: 18px; }
.photo-placeholder {
  width: 100%;
  height: 220px;
  border-radius: 18px;
  background: rgba(184,232,255,0.25);
  border: 1.5px dashed rgba(114,216,196,0.5);
}
.photo-icon { font-size: 40px; }

.section-title { margin: 20px 4px 10px; }
.scene-row { flex-wrap: wrap; }
.scene-pill {
  padding: 10px 16px;
  border-radius: 999px;
  background: rgba(255,255,255,0.8);
  border: 1.5px solid rgba(184,232,255,0.6);
  font-size: 13px;
  color: var(--yy-text-sub);
}
.scene-pill.on {
  background: rgba(114,216,196,0.15);
  border-color: var(--yy-primary);
  color: var(--yy-primary);
  font-weight: 600;
}

.footer-btn {
  position: fixed;
  left: 20px;
  right: 20px;
  bottom: 28px;
}
.btn.disabled { opacity: 0.5; }

/* V0.6 身心状态自选标签 */
.physical-row { display: flex; flex-wrap: wrap; gap: 10px; padding: 8px 18px 0; }
.physical-pill {
  padding: 8px 16px;
  border-radius: 999px;
  background: #FFF;
  border: 1.5px solid rgba(184,232,255,0.6);
  color: #5A7A72;
  font-size: 13px;
}
.physical-pill.on {
  background: #72D8C4;
  border-color: #72D8C4;
  color: #FFF;
  font-weight: 600;
}
.other-input { padding: 10px 18px 0; }
.other-field {
  background: #FFF;
  border-radius: 12px;
  padding: 8px 12px;
  font-size: 13px;
  border: 1.5px solid rgba(114,216,196,0.4);
}
