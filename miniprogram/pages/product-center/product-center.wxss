/* 充氧宝产品中心（Bar 随内容流式，无需预留固定空位） */
.page.product {
  padding-bottom: 24px;
  background:
    radial-gradient(600px 400px at 85% -5%, rgba(91,201,179,0.12), transparent 60%),
    radial-gradient(500px 380px at 5% 20%, rgba(114,216,196,0.08), transparent 55%),
    linear-gradient(180deg, #F0F9F6 0%, #EEFBF7 100%);
}

/* 顶部 Header：产品名 + 卖点（精修字距，呼吸感） */
.prod-header { padding: 20px 0 6px; }
.prod-brand {
  font-size: 24px; font-weight: 300; color: #1F3833;
  letter-spacing: 6px;
  text-transform: uppercase;
}
.prod-tagline {
  margin-top: 6px; font-size: 12px; color: rgba(0,0,0,0.45);
  letter-spacing: 1px;
}

/* 形态联动展示区：纯透明悬浮舞台 + 径向光晕（去掉浅绿框） */
.prod-show { margin-top: 12px; }
.prod-stage {
  position: relative; height: 380px;
  background: transparent;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.stage-glow {
  position: absolute; left: 50%; top: 40%; width: 260px; height: 260px;
  transform: translate(-50%, -50%);
  background: radial-gradient(closest-side, rgba(0,230,184,0.22), transparent 72%);
  border-radius: 50%; pointer-events: none; z-index: 1;
}
.prod-stage-img {
  position: relative; width: 300px; height: 300px; z-index: 2;
  filter: drop-shadow(0 22px 38px rgba(20,60,50,0.35));
}
/* 纯白款（带白底过渡）：乘法混合融底 */
.prod-stage-img--blend {
  mix-blend-mode: multiply;
  filter: drop-shadow(0 20px 34px rgba(20,60,50,0.2));
}

/* 高定配色球（Color Swatches） */
.swatches { gap: 20px; margin-top: 16px; justify-content: center; }
.swatch {
  width: 30px; height: 30px; border-radius: 50%;
  border: 3px solid #fff;
  box-shadow: 0 4px 12px rgba(23,72,60,0.25);
  transition: transform 0.2s;
}
.swatch.on {
  transform: scale(1.22);
  box-shadow: 0 0 0 3px rgba(91,201,179,0.5), 0 6px 16px rgba(23,72,60,0.3);
}
.sw-ice  { background: radial-gradient(circle at 32% 28%, #dff5ff, #7fd0e8 45%, #3a91b8 90%); }
.sw-tibet{ background: radial-gradient(circle at 32% 28%, #ffd68a, #e2583e 40%, #7a2d63 90%); }
.sw-white{ background: radial-gradient(circle at 32% 28%, #ffffff, #eceff0 55%, #c6cdd1 90%); }
.style-desc {
  display: block; text-align: center; margin-top: 10px;
  font-size: 13px; color: #2A4A42;
}

/* 分段导航：iOS 极简悬浮 Segmented Control */
.seg {
  margin: 14px 16px 0;
  background: rgba(255,255,255,0.6);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  border-radius: 14px; padding: 4px;
  border: 1px solid rgba(138,160,160,0.15);
  box-shadow: 0 4px 16px rgba(23,72,60,0.06);
}
.seg-item {
  flex: 1; text-align: center; padding: 9px 0; border-radius: 11px;
  font-size: 13px; font-weight: 500; color: rgba(0,0,0,0.55);
  transition: all 0.3s ease;
}
.seg-item.on {
  background: linear-gradient(135deg, rgba(0,230,184,0.28), rgba(0,179,143,0.22));
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  color: #0E7A68; font-weight: 700;
  box-shadow: 0 2px 10px rgba(0,230,184,0.18), inset 0 1px 0 rgba(255,255,255,0.4);
}

/* 统一分区（去大白卡断层，用分区标题 + 背景底色） */
.prod-sec { margin-top: 22px; }
.sec-title {
  font-size: 15px; font-weight: 700; color: #1F3833;
  margin-bottom: 10px; padding-left: 10px;
  border-left: 4px solid var(--yy-primary);
}

/* 参数：2x2 微晶玻璃网格（线条 Icon + 大数字驱动） */
.spec-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
}
.spec-cell {
  background: linear-gradient(160deg, rgba(255,255,255,0.82), rgba(234,250,244,0.55));
  backdrop-filter: blur(12px);
  border-radius: 18px; padding: 18px 12px 14px;
  border: 1px solid rgba(114,216,196,0.16);
  box-shadow: 0 6px 18px rgba(23,72,60,0.06);
  display: flex; flex-direction: column; align-items: center; text-align: center;
}
.spec-cell-ico { width: 34px; height: 34px; }
.spec-cell-numrow { display: flex; align-items: baseline; gap: 4px; margin-top: 6px; }
.spec-cell-title {
  font-size: 30px; font-weight: 800; color: #1F3833; line-height: 1;
  text-shadow: 0 2px 10px rgba(91,201,179,0.25);
}
.spec-cell-unit { font-size: 13px; font-weight: 600; color: var(--yy-primary); }
.spec-cell-desc { font-size: 11px; margin-top: 4px; }

/* 技术：原理视频卡片（微缩 16:9 + 微光边框） */
.tech-video-wrap {
  margin-top: 8px; position: relative;
  border-radius: 20px; overflow: hidden;
  border: 1px solid rgba(0,230,184,0.3);
  box-shadow: 0 12px 32px rgba(23,72,60,0.14), 0 0 20px rgba(0,230,184,0.12);
}
.tech-video { width: 100%; height: 180px; display: block; }
/* 封面层（本地图，替代 poster——poster 只支持网络地址） */
.tech-cover {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  transition: opacity 0.25s;
}
.tech-cover--hide { opacity: 0; pointer-events: none; }
.tech-cover-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.tech-play-btn {
  position: relative; z-index: 2;
  width: 64px; height: 64px; border-radius: 50%;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.6);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8px 24px rgba(23,72,60,0.2);
  animation: playPulse 2s ease-in-out infinite;
}
@keyframes playPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(0,230,184,0.4), 0 8px 24px rgba(23,72,60,0.2); }
  50% { box-shadow: 0 0 0 16px rgba(0,230,184,0), 0 8px 28px rgba(0,230,184,0.25); }
}
.tech-play-ico {
  color: #fff; font-size: 26px; margin-left: 4px;
  text-shadow: 0 2px 8px rgba(23,72,60,0.4);
}

/* 技术：发光流向线（3 步） */
.tech-flowline {
  display: flex; align-items: stretch; gap: 6px;
  margin-top: 22px;
}
.tf-node {
  flex: 1; display: flex; flex-direction: column; align-items: center; text-align: center;
  padding: 18px 6px;
  background: rgba(255,255,255,0.75);
  backdrop-filter: blur(10px);
  border-radius: 18px;
  border: 1px solid rgba(114,216,196,0.2);
}
.tf-ico { font-size: 26px; }
.tf-name { font-size: 13px; font-weight: 700; color: #1F3833; margin-top: 6px; }
.tf-sub { font-size: 11px; margin-top: 2px; }
.tf-link {
  width: 26px; display: flex; align-items: center; justify-content: center;
}
.tf-arrow {
  color: var(--yy-primary); font-size: 16px; font-weight: 700;
  animation: tfPulse 1.6s ease-in-out infinite;
}
@keyframes tfPulse {
  0%, 100% { opacity: 0.4; transform: translateX(-2px); }
  50% { opacity: 1; transform: translateX(2px); }
}

.tech-desc { line-height: 1.7; margin-top: 14px; display: block; }

/* 技术：PK 对比双卡 */
.tech-pk { gap: 12px; margin-top: 18px; }
.pk-card {
  flex: 1; border-radius: 20px; padding: 16px 14px;
  backdrop-filter: blur(10px);
}
.pk-win {
  background: linear-gradient(160deg, rgba(91,201,179,0.25), rgba(114,216,196,0.12));
  border: 1px solid rgba(91,201,179,0.4);
}
.pk-lose {
  background: rgba(200,205,205,0.35);
  border: 1px solid rgba(138,150,150,0.25);
}
.pk-title { font-size: 14px; font-weight: 700; color: #1F3833; margin-bottom: 10px; display: block; }
.pk-line { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #2A4A42; margin-bottom: 6px; }
.pk-chip {
  width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0;
  color: #fff; font-size: 11px; line-height: 18px; text-align: center;
  background: var(--yy-primary);
}
.pk-chip-x { background: #b0b8b8; }
.core-line {
  display: block; margin-top: 14px; font-size: 12px; color: var(--yy-primary);
  background: rgba(114,216,196,0.1); border-radius: 12px; padding: 10px; text-align: center;
}

/* 场景：Find Your Air 引导 */
.air-guide {
  margin-top: 18px; padding: 4px 8px 2px;
  background: radial-gradient(80% 120% at 50% 0%, rgba(91,201,179,0.12), transparent 75%);
}
.air-title {
  font-size: 26px; font-weight: 700; color: #1F3833;
  letter-spacing: 2px; display: block;
}
.air-sub { font-size: 12px; color: rgba(0,0,0,0.45); margin-top: 4px; display: block; }

/* 场景：横向滑动场景卡（iOS Cards 轮播，通透无白框） */
.scene-swiper { width: 100%; }
.scene-card {
  position: relative; height: 280px; margin: 0 6px;
  border-radius: 26px; overflow: hidden;
  border: 1px solid rgba(0,230,184,0.2);
  box-shadow: 0 16px 40px rgba(23,72,60,0.12);
}
.scene-card-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
/* 硬件产品图：玻璃质感圆角容器，右侧居中，融入背景 */
.scene-hw-wrap {
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  width: 120px;
  height: 120px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
  border-radius: 22px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  z-index: 3;
  box-shadow: 0 12px 28px rgba(6, 32, 26, 0.35);
}
.scene-hw {
  width: 90px;
  height: 90px;
  background: transparent;
  border: none;
}
.scene-card-mask {
  position: absolute; left: 0; right: 0; bottom: 0; height: 55%;
  background: linear-gradient(0deg, rgba(6,32,26,0.85) 0%, rgba(6,32,26,0) 100%);
}
.scene-card-info {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 20px 22px 24px;
  z-index: 4;
}
.scene-card-title {
  font-size: 26px; font-weight: 700; color: #FFFFFF;
  letter-spacing: 1px; display: block;
  text-shadow: 0 2px 12px rgba(0,0,0,0.3);
}
.scene-card-sub { font-size: 13px; color: rgba(255,255,255,0.85); display: block; margin-top: 4px; }

/* 场景：联动信息区（去框化，通透呈现，呼吸感留白） */
.combo-card {
  margin-top: 20px; padding: 0 6px;
  background: transparent;
  border: none;
  box-shadow: none;
}
.combo-row { display: flex; align-items: center; gap: 12px; padding: 13px 0; }
.combo-row + .combo-row { border-top: 1px dashed rgba(0,230,184,0.18); }
.combo-ico { width: 24px; height: 24px; }
.combo-k { font-size: 12px; color: #7AA799; width: 44px; letter-spacing: 1px; }
.combo-v { font-size: 15px; font-weight: 600; color: #1F3833; }
.combo-fit {
  display: block; font-size: 12px; color: #5F7F72; margin-top: 8px;
  padding-top: 14px; border-top: 1px dashed rgba(0,230,184,0.18);
}
.combo-link {
  margin-top: 18px; padding: 14px;
  border-radius: 16px;
  background: linear-gradient(135deg, #00E6B8, #00B38F);
  color: #fff; font-size: 15px; font-weight: 700;
  letter-spacing: 2px;
  border: none;
  box-shadow: 0 8px 24px rgba(0,230,184,0.35);
}

/* 认证：2×2 横向网格信任墙 */
.cert-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
}
.cert-item {
  display: flex; align-items: center; gap: 12px;
  padding: 16px 14px;
  background: rgba(255,255,255,0.72);
  border-radius: 12px;
  border: 1px solid rgba(114,216,196,0.18);
  box-shadow: 0 6px 18px rgba(23,72,60,0.06);
}
.cert-icon { width: 34px; height: 34px; flex-shrink: 0; }
.cert-body { display: flex; flex-direction: column; }
.cert-title { font-size: 14px; font-weight: 700; color: #1F3833; }
.cert-desc { font-size: 11px; color: #5F7F72; margin-top: 3px; }

/* FAQ：三 Tab 分类 */
.faq-tabs { gap: 8px; margin-top: 12px; }
.faq-tab {
  flex: 1; text-align: center; padding: 9px 0;
  border-radius: 999px;
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(114,216,196,0.2);
  font-size: 13px; color: #5F7F72;
  transition: all 0.25s;
}
.faq-tab.on {
  background: linear-gradient(135deg, rgba(0,230,184,0.24), rgba(0,179,143,0.18));
  color: #0E7A68; font-weight: 700;
  border-color: transparent;
}

/* FAQ：手风琴折叠 */
.faq-list { display: flex; flex-direction: column; gap: 10px; }
.faq-item {
  background: rgba(255,255,255,0.7);
  border-radius: 12px;
  border: 1px solid rgba(114,216,196,0.16);
  overflow: hidden;
}
.faq-q { padding: 14px 14px; align-items: center; }
.faq-q-text { flex: 1; font-size: 14px; font-weight: 700; color: #1F3833; }
.faq-arrow {
  color: var(--yy-primary); font-size: 14px; font-weight: 700;
  transition: transform 0.3s;
  margin-left: 8px;
}
.faq-arrow.up { transform: rotate(180deg); }
.faq-a-wrap {
  max-height: 0; overflow: hidden; opacity: 0;
  transition: max-height 0.35s ease, opacity 0.3s ease;
}
.faq-a-wrap.open {
  max-height: 200px; opacity: 1;
}
.faq-a {
  display: block; padding: 0 14px 14px;
  line-height: 1.7; color: #5a6b6b; font-size: 13px;
}

/* 底部 CTA（随内容流式，滚到底时自然落在 tabBar 上方） */
.buy-bar {
  margin: 20px 16px 8px;
  padding: 12px;
  background: rgba(255,255,255,0.9); backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-radius: 20px;
  border: 1px solid rgba(138,160,160,0.15);
  box-shadow: 0 8px 24px rgba(23,72,60,0.08);
  gap: 12px;
}
.buy-btn {
  height: 48px; border-radius: 999px; font-size: 15px; font-weight: 600;
}
.buy-btn--ghost {
  background: #fff; color: var(--yy-primary); border: 2px solid var(--yy-primary);
}
.buy-btn--primary {
  background: linear-gradient(135deg, #5BC9B3 0%, #3FA68F 100%);
  color: #fff;
  box-shadow: 0 6px 20px rgba(91,201,179,0.5);
}

/* ========== 组合抽屉 Bottom Sheet ========== */
/* 遮罩：背景 20px 高斯模糊 */
.sheet-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(12,20,18,0.28);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s;
  z-index: 90;
}
.sheet-mask--show { opacity: 1; pointer-events: auto; }

/* 抽屉：半屏毛玻璃，从底部滑出 */
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  height: 78vh;
  background: rgba(245,251,248,0.92);
  backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  border-radius: 26px 26px 0 0;
  border: 1px solid rgba(255,255,255,0.6);
  border-bottom: none;
  box-shadow: 0 -12px 40px rgba(23,72,60,0.18);
  padding: 10px 20px 24px;
  transform: translateY(110%);
  transition: transform 0.4s cubic-bezier(0.32, 0.72, 0.28, 1);
  z-index: 100;
  box-sizing: border-box;
}
.sheet--open { transform: translateY(0); }

.sheet-handle {
  width: 40px; height: 5px; border-radius: 999px;
  background: rgba(0,0,0,0.15); margin: 4px auto 14px;
}

/* ① 全家福 Showcase（contain 完整呈现，自然融合无硬框） */
.sheet-show { width: 100%; margin-top: 10px; }
.sheet-show-img {
  width: 100%; height: 350rpx;
  background: transparent;
}

/* 清单：单行三列（硬件/香氛/配件，极简无背景框） */
.sheet-tags {
  display: flex; align-items: stretch; gap: 0;
  margin-top: 22px;
  background: transparent;
}
.sheet-tag {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 0 6px;
}
.sheet-tag + .sheet-tag { border-left: 1px dashed rgba(0,230,184,0.2); }
.st-ico { font-size: 18px; }
.st-t { font-size: 10px; color: #7AA799; margin-top: 6px; letter-spacing: 1px; }
.st-v { font-size: 12px; color: #1F3833; font-weight: 600; margin-top: 3px; text-align: center; }
.sheet-scene {
  display: block; font-size: 12px; color: #7A93A8; margin-top: 16px; text-align: center;
}

/* ② 模式双选（卡片适度压低，视觉重心还给主图） */
.sheet-plans { gap: 12px; margin-top: 20px; }
.sheet-plan {
  flex: 1; padding: 10px 12px; border-radius: 16px;
  background: rgba(255,255,255,0.6);
  border: 1.5px solid rgba(114,216,196,0.2);
  text-align: center; position: relative;
  transition: all 0.25s;
}
.sheet-plan.on {
  border-color: #00E6B8;
  background: linear-gradient(160deg, rgba(0,230,184,0.18), rgba(0,179,143,0.1));
  box-shadow: 0 6px 18px rgba(0,230,184,0.2);
}
.sp-kind { font-size: 12px; color: #5F7F72; display: block; }
.sp-plan.on .sp-kind { color: #0E7A68; }
.sp-price { font-size: 13px; color: #1F3833; font-weight: 600; margin-top: 4px; display: block; }
.sp-num { font-size: 24px; font-weight: 700; color: var(--yy-primary); }
.sp-rec {
  position: absolute; top: -8px; right: 12px;
  font-size: 10px; color: #fff;
  background: linear-gradient(135deg, #00E6B8, #00B38F);
  padding: 2px 9px; border-radius: 999px;
}

/* ③ 主 CTA（拉宽 + 加大四周留白） */
.sheet-cta {
  margin: 24px 2px 4px; padding: 15px;
  border-radius: 18px;
  background: linear-gradient(135deg, #00E6B8, #00B38F);
  color: #fff; font-size: 16px; font-weight: 700;
  letter-spacing: 3px;
  box-shadow: 0 10px 28px rgba(0,230,184,0.4);
}
.sheet-cta-hover { opacity: 0.9; }
