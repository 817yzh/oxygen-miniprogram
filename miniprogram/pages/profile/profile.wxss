/* 我的页面 V2.0 · 氧气数字绿洲 / 健康能量仪表盘 */
page {
  height: 100%;
}

.profile-page {
  min-height: 100%;
  background: linear-gradient(180deg, #E8F7F2 0%, #F0FAF7 40%, #F5FCFA 100%);
  padding: 20rpx 24rpx 32rpx;
  box-sizing: border-box;
  /* 允许顶部流光/尾巴向外溢出，不被切 */
  overflow: visible;
}

/* ========== 顶部：氧气身份卡（整图背景版 V3） ========== */
.user-card {
  position: relative;
  /* 固定高度 160px = 320rpx */
  height: 320rpx;
  border-radius: 28rpx;
  overflow: visible; /* 流光尾部/宇航底座可向外溢出，不被裁剪 */
  margin-bottom: 48rpx; /* 底部留出溢出呼吸空间 */
  box-shadow: 0 12rpx 36rpx rgba(23, 72, 60, 0.18);
  /* 本地背景用 image 标签铺底，此处留透明（wxss 不支持本地 url 背景图） */
  background: transparent;
}

/* 整图垫底层：铺满卡片并略放大，让流光尾部能溢出卡片下沿 */
.user-card-bg {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 130%; /* 横向留出 margin 便于 overflow 到卡片外 */
  height: 125%; /* 纵向略超，露出底部流光尾巴 */
  transform: translate(-50%, -52%);
  pointer-events: none;
  z-index: 1;
}

/* 文字层：绝对定位盖在背景图的深青区域上方 */
.user-card-content {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  padding: 0 24rpx 0 200rpx; /* 左侧留出给宇航主体，文字靠深青区 */
  box-sizing: border-box;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  line-height: 1.2;
  /* 压深青底色上保证清晰 */
  text-shadow: 0 2rpx 8rpx rgba(7, 32, 25, 0.8), 0 0 2rpx rgba(7, 32, 25, 0.9);
}

.user-tag {
  align-self: flex-start;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(114, 216, 196, 0.25);
  border: 1rpx solid rgba(114, 216, 196, 0.4);
  color: #A8E6D5;
  font-size: 22rpx;
  font-weight: 600;
}

.user-guide {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.5;
}

/* 氧气值进度条 */
.oxygen-bar {
  position: relative;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 18rpx;
  margin-top: 6rpx;
  overflow: hidden;
}

.oxygen-bar-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #72D8C4 0%, #5BC9B3 100%);
  border-radius: 18rpx;
  transition: width 0.6s ease;
}

.oxygen-bar-text {
  position: relative;
  z-index: 2;
  display: block;
  text-align: center;
  line-height: 36rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 陪伴天数徽章：右侧居中，避开文字区 */
.companion-badge {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: rgba(114, 216, 196, 0.3);
  border: 2rpx solid rgba(114, 216, 196, 0.6);
  backdrop-filter: blur(8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 6;
  box-shadow: 0 4rpx 16rpx rgba(114, 216, 196, 0.35);
}

.badge-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #A8E6D5;
  line-height: 1;
}

.badge-label {
  font-size: 16rpx;
  color: rgba(168, 230, 213, 0.8);
  margin-top: 4rpx;
}

/* ========== 中部：核心数据看板 ========== */
.dash-grid {
  position: relative;
  z-index: 3;
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dash-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(114, 216, 196, 0.15);
  box-shadow: 0 6rpx 20rpx rgba(23, 72, 60, 0.06);
}

.dash-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  border-radius: 14rpx;
  margin-bottom: 12rpx;
}

.dash-cell--oxygen .dash-icon {
  background: linear-gradient(135deg, rgba(114, 216, 196, 0.25), rgba(184, 232, 255, 0.2));
}

.dash-cell--emotion .dash-icon {
  background: linear-gradient(135deg, rgba(91, 201, 179, 0.25), rgba(114, 216, 196, 0.2));
}

.dash-cell--growth .dash-icon {
  background: linear-gradient(135deg, rgba(155, 200, 150, 0.25), rgba(114, 216, 196, 0.2));
}

.dash-num-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.dash-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #1F3833;
  line-height: 1;
}

.dash-unit {
  font-size: 20rpx;
  color: #5BC9B3;
  font-weight: 600;
}

.dash-label {
  font-size: 20rpx;
  color: #7AA799;
  text-align: center;
}

/* ========== 下部：功能分组卡 ========== */
.grp-card {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(12rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(114, 216, 196, 0.15);
  box-shadow: 0 6rpx 20rpx rgba(23, 72, 60, 0.05);
  padding: 8rpx 20rpx;
  margin-bottom: 20rpx;
}

.grp-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #5A8A7A;
  letter-spacing: 1rpx;
  padding: 16rpx 4rpx 12rpx;
}

.grp-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid rgba(114, 216, 196, 0.1);
}

.grp-item:last-child {
  border-bottom: none;
}

.grp-ico {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: rgba(114, 216, 196, 0.1);
}

.grp-text {
  flex: 1;
  font-size: 28rpx;
  color: #1F3833;
  font-weight: 500;
}

.grp-text--danger {
  color: #D4756A;
}

.grp-arrow {
  font-size: 32rpx;
  color: #A8C5BC;
  flex-shrink: 0;
}

.grp-status {
  font-size: 22rpx;
  color: #5BC9B3;
  font-weight: 600;
  flex-shrink: 0;
}

/* 底部 */
.about {
  text-align: center;
  font-size: 20rpx;
  color: #B8CBC9;
  margin-top: 16rpx;
  padding-bottom: 20rpx;
}
