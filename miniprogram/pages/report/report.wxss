/* Page 7 · AI状态报告页 (V5.0 杂志手账重构) */
.report-container {
  background: linear-gradient(180deg, #EDF8F4 0%, #F8FBFA 30%, #F8FBFA 100%);
  padding: 16px 16px 120px;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 顶部 Hero：今日氧气状态 (沉浸式大卡) ===== */
.hero-card {
  position: relative;
  border-radius: 28px;
  overflow: hidden;
  padding: 34px 22px 24px;
  margin-bottom: 14px;
  background: linear-gradient(150deg, #0F2E25 0%, #14503F 55%, #1E6B52 100%);
  box-shadow: 0 18px 44px rgba(20,80,63,0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
/* 氛围光晕 */
.hero-glow {
  position: absolute;
  top: -30%;
  left: 50%;
  transform: translateX(-50%);
  width: 380px;
  height: 380px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114,216,196,0.28) 0%, rgba(114,216,196,0) 70%);
  pointer-events: none;
}
/* IP 漂浮在顶部 */
.hero-ip {
  position: relative;
  width: 108px;
  height: 108px;
  margin-bottom: 6px;
  animation: heroFloat 3.6s ease-in-out infinite;
}
@keyframes heroFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
.hero-kicker {
  position: relative;
  font-size: 12px;
  color: rgba(184,232,255,0.8);
  letter-spacing: 2px;
  font-weight: 600;
}
.hero-state {
  position: relative;
  margin-top: 6px;
  font-size: 32px;
  font-weight: 800;
  color: #FFFFFF;
  text-shadow: 0 4px 20px rgba(0,0,0,0.25);
}
.hero-desc {
  position: relative;
  margin-top: 4px;
  font-size: 13px;
  color: rgba(214,245,236,0.8);
}
/* 能量大数 */
.hero-energy {
  position: relative;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8px;
  margin-top: 20px;
}
.hero-energy-val {
  font-size: 52px;
  font-weight: 800;
  color: #B8F5E2;
  line-height: 1;
  text-shadow: 0 0 30px rgba(114,216,196,0.5);
}
.hero-energy-unit { font-size: 22px; font-weight: 700; }
.hero-energy-label {
  font-size: 13px;
  color: rgba(214,245,236,0.75);
}
.hero-progress {
  position: relative;
  width: 70%;
  height: 8px;
  border-radius: 999px;
  background: rgba(255,255,255,0.15);
  overflow: hidden;
  margin-top: 12px;
}
.hero-progress-inner {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #6FE0C6, #B8F5E2);
  box-shadow: 0 0 16px rgba(111,224,198,0.7);
}
.hero-sub {
  position: relative;
  margin-top: 12px;
  font-size: 12px;
  color: rgba(214,245,236,0.7);
}
/* 氧疗引导 (能量低时) */
.hero-guide {
  position: relative;
  margin-top: 18px;
  width: 100%;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 16px;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  backdrop-filter: blur(8px);
}
.hero-guide-tag {
  flex-shrink: 0;
  background: linear-gradient(135deg, #6FE0C6, #38C0A0);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 999px;
}
.hero-guide-text {
  flex: 1;
  font-size: 12px;
  line-height: 1.5;
  color: #E8FAF4;
  text-align: left;
}
.hero-guide-arrow {
  font-size: 12px;
  color: #B8F5E2;
  font-weight: 700;
  white-space: nowrap;
}

/* ===== 数据能量舱 (聚合卡片) ===== */
.energy-cabin {
  background: #FFFFFF;
  border-radius: 24px;
  padding: 18px;
  margin-bottom: 14px;
  box-shadow: 0 8px 24px rgba(40,120,100,0.08);
}
.cabin-keywords {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 16px;
}
.cabin-label {
  font-size: 14px;
  font-weight: 700;
  color: #1F3833;
}
.cabin-tags { display: flex; gap: 8px; }
.cabin-tag {
  padding: 5px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  background: #F0F7F5;
  color: #5B7A72;
}
.cabin-tag.on {
  background: linear-gradient(135deg, #72D8C4, #4A9E8E);
  color: #fff;
}
/* 3 统计宫格 */
.cabin-stats {
  display: flex;
  justify-content: space-around;
  padding: 14px 0;
  border-top: 1px solid #F0F6F4;
  border-bottom: 1px solid #F0F6F4;
  margin-bottom: 14px;
}
.cabin-stat { text-align: center; }
.cabin-stat-val { font-size: 16px; font-weight: 700; color: #2B5B52; display: block; }
.cabin-stat-label { font-size: 11px; color: #9BB7AE; margin-top: 4px; display: block; }
/* 等级进度 */
.cabin-level-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: #4A5F59;
  font-weight: 600;
  margin-bottom: 8px;
}
.cabin-level-link { color: #38C0A0; font-size: 12px; }
.cabin-level-track {
  position: relative;
  height: 12px;
  background: #E2F2EC;
  border-radius: 6px;
}
.cabin-level-inner {
  height: 100%;
  background: linear-gradient(90deg, #38C0A0, #72D8C4);
  border-radius: 6px;
}
.cabin-level-ip {
  position: absolute;
  top: -14px;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #FFF;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
.cabin-level-foot {
  margin-top: 8px;
  font-size: 11px;
  color: #9BB7AE;
}

/* ===== 通用卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 18px;
  margin-bottom: 14px;
  box-shadow: 0 4px 12px rgba(40,120,100,0.05);
}
.card-title {
  font-weight: 700;
  font-size: 16px;
  color: #1F3833;
  margin-bottom: 12px;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.card-header .card-title { margin-bottom: 0; }
.score-tip { font-size: 12px; color: #9BB7AE; }

/* ===== 氧气解读 ===== */
.inter-content {
  font-size: 14px;
  color: #3A4F4A;
  line-height: 1.9;
}

/* ===== 恢复建议 ===== */
.advice-single {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #F7FCFA;
  border-radius: 14px;
  padding: 14px;
}
.icon-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}
.green-bg { background: #DFF4ED; }
.advice-text { flex: 1; font-size: 14px; color: #3A4F4A; line-height: 1.6; }
.product-hint { font-size: 12px; color: #7A8E88; padding: 0 4px; }
.mt-12 { margin-top: 12px; }
.bottom-tip {
  margin-top: 12px;
  background: #FFFBEB;
  padding: 10px;
  border-radius: 10px;
  font-size: 12px;
  color: #8C6D23;
  line-height: 1.6;
}

/* ===== 情绪趋势总结 ===== */
.trend-summary-card { background: linear-gradient(135deg, #FFF7EC, #FFFFFF); }
.sum-body { display: flex; align-items: flex-start; gap: 10px; }
.sum-trend { font-size: 24px; }
.sum-text { flex: 1; font-size: 15px; line-height: 1.8; color: #3A4F4A; }

/* ===== 氧氧想对你说 (手账气泡) ===== */
.speak-card {
  background: linear-gradient(135deg, #EDF8F4 0%, #F7FCFA 100%);
  border-radius: 20px;
  padding: 18px;
  margin-bottom: 14px;
}
.speak-body {
  display: flex;
  align-items: center;
  gap: 12px;
}
.chat-bubble {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16px;
  border-top-left-radius: 4px;
  padding: 14px;
  font-size: 13px;
  color: #2B5B52;
  line-height: 1.9;
  box-shadow: 0 4px 16px rgba(114,216,196,0.15);
}
.ip-img-large { width: 80px; height: 80px; }

/* ===== 场景联动推荐 ===== */
.scene-rec-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.scene-rec-icon { font-size: 22px; }
.scene-rec-text { font-size: 13px; color: #264653; line-height: 1.6; }
.scene-rec-btn {
  background: linear-gradient(135deg, #72D8C4, #4A9E8E);
  color: #FFF;
  border: none;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 600;
  padding: 12px 0;
  width: 100%;
}
.scene-rec-btn::after { border: none; }

/* ===== 成就通知横幅 ===== */
.achieve-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px;
  margin-bottom: 14px;
  border-radius: 16px;
  background: linear-gradient(135deg, #FFF3D6, #FFE9B8);
  box-shadow: 0 4px 14px rgba(255, 180, 60, 0.2);
  animation: bannerIn 0.4s ease;
}
.achieve-banner-icon { font-size: 22px; }
.achieve-banner-text { font-size: 14px; font-weight: 700; color: #B07A2E; }
@keyframes bannerIn {
  from { transform: translateY(-16px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* ===== 底部吸底操作栏 ===== */
.report-actions {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  gap: 12px;
  padding: 14px 20px calc(14px + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(248,251,250,0.85), rgba(248,251,250,0.98));
  backdrop-filter: blur(16px);
  border-top: 1px solid rgba(114,216,196,0.15);
  z-index: 100;
  max-width: 520px;
  margin: 0 auto;
}
.ra-btn {
  flex: 1;
  height: 50px;
  line-height: 50px;
  border-radius: 25px;
  font-size: 15px;
  font-weight: 700;
  text-align: center;
  padding: 0;
  margin: 0;
}
.ra-btn::after { border: none; }
.ra-btn--ghost {
  background: rgba(255,255,255,0.9);
  color: #4A9E8E;
  border: 1.5px solid rgba(114,216,196,0.6);
}
.ra-btn--primary {
  background: linear-gradient(135deg, #6FE0C6 0%, #38C0A0 100%);
  color: #FFF;
  box-shadow: 0 8px 24px rgba(56,192,160,0.35);
}
/* 吸底占位 */
.action-spacer { height: 76px; }

/* ===== 工具类 ===== */
.aux { font-size: 12px; color: #8AA0A0; }
.center { display: flex; align-items: center; justify-content: center; }

/* ===== 雷达图 canvas 容器 ===== */
.radar-canvas-box { width: 100%; }
