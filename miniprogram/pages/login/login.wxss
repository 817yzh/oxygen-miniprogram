/* pages/login/login.wxss · 晨曦微光心灵引力场（全新架构：通透大背景 + 悬浮IP + 关键词徽章矩阵） */

.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #EBF5F1 0%, #D4EBE3 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
}

/* ===== 流动光影氛围层 ===== */
.lg-aura {
  position: fixed;
  border-radius: 50%;
  filter: blur(70rpx);
  pointer-events: none;
  z-index: 0;
}
.aura-1 {
  width: 620rpx; height: 620rpx;
  left: -180rpx; top: -140rpx;
  background: radial-gradient(circle, rgba(96,205,180,0.5), transparent 72%);
  animation: auraFloat 9s ease-in-out infinite;
}
.aura-2 {
  width: 560rpx; height: 560rpx;
  right: -160rpx; top: 30%;
  background: radial-gradient(circle, rgba(255,250,240,0.9), transparent 72%);
  animation: auraFloat 12s ease-in-out infinite reverse;
}
.aura-3 {
  width: 700rpx; height: 700rpx;
  left: 12%; bottom: -200rpx;
  background: radial-gradient(circle, rgba(120,224,200,0.4), transparent 72%);
  animation: auraFloat 14s ease-in-out infinite;
}
@keyframes auraFloat {
  0%,100% { transform: translate(0,0) scale(1); opacity: 0.9; }
  50% { transform: translate(26rpx,-30rpx) scale(1.06); opacity: 0.55; }
}
/* 细腻噪点（杂志纸感） */
.lg-grain {
  position: fixed; inset: 0;
  background-image: radial-gradient(rgba(20,60,50,0.05) 1px, transparent 1px);
  background-size: 24rpx 24rpx;
  opacity: 0.5;
  pointer-events: none; z-index: 0;
}
/* 顶部微光斜射 */
.lg-lights {
  position: fixed;
  pointer-events: none; z-index: 0;
  opacity: 0.7;
}
.light-1 {
  width: 500rpx; height: 260rpx;
  left: -120rpx; top: 8%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.55), transparent);
  transform: rotate(-18deg);
  filter: blur(30rpx);
  animation: lightShift 8s ease-in-out infinite;
}
.light-2 {
  width: 420rpx; height: 220rpx;
  right: -100rpx; top: 42%;
  background: linear-gradient(100deg, transparent, rgba(190,255,235,0.5), transparent);
  transform: rotate(14deg);
  filter: blur(26rpx);
  animation: lightShift 10s ease-in-out infinite reverse;
}
@keyframes lightShift {
  0%,100% { transform: rotate(-18deg) translateX(0); opacity: 0.6; }
  50% { transform: rotate(-18deg) translateX(40rpx); opacity: 0.9; }
}

/* ===== 微光悬浮粒子（氧气泡泡） ===== */
.lg-bubble-lg,
.lg-bubble-sm {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  background: radial-gradient(circle at 32% 28%,
    rgba(255,255,255,0.75),
    rgba(205,255,240,0.35) 55%,
    rgba(205,255,240,0.12) 78%,
    transparent 100%);
  box-shadow:
    inset 0 2rpx 6rpx rgba(255,255,255,0.85),
    0 6rpx 16rpx rgba(46,196,182,0.12);
  border: 1rpx solid rgba(255,255,255,0.6);
}
.lg-bubble-lg { width: 90rpx; height: 90rpx; }
.lg-bubble-sm { width: 46rpx; height: 46rpx; opacity: 0.85; }
.bubble-p1 { left: 12%; top: 30%; animation: bobUp 7s ease-in-out infinite; }
.bubble-p2 { right: 14%; top: 24%; width: 64rpx; height: 64rpx; animation: bobUp 9s ease-in-out infinite 1.5s; }
.bubble-p3 { left: 20%; top: 55%; animation: bobUp 8s ease-in-out infinite 0.8s; }
.bubble-p4 { right: 22%; top: 58%; animation: bobUp 6.5s ease-in-out infinite 2s; }
.bubble-p5 { left: 30%; top: 20%; animation: bobUp 7.5s ease-in-out infinite 3s; }
.bubble-p6 { right: 10%; top: 46%; animation: bobUp 8.5s ease-in-out infinite 0.4s; }
@keyframes bobUp {
  0%,100% { transform: translateY(0); opacity: 0.6; }
  50% { transform: translateY(-34rpx); opacity: 1; }
}

/* ===== 顶部清爽视觉 ===== */
.lg-hero {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  z-index: 1;
  padding-top: 60rpx;
}
/* 呼呼身后 · 超大晨曦薄荷呼吸光晕 */
.lg-back-glow {
  position: absolute;
  top: 34%; left: 50%;
  width: 720rpx; height: 720rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114,216,196,0.5), rgba(152,235,215,0.2) 45%, transparent 72%);
  filter: blur(16rpx);
  animation: backGlow 4.5s ease-in-out infinite;
}
@keyframes backGlow {
  0%,100% { transform: translate(-50%,-50%) scale(0.9); opacity: 0.7; }
  50% { transform: translate(-50%,-50%) scale(1.14); opacity: 1; }
}
/* IP 呼吸光晕 */
.lg-halo {
  position: absolute;
  top: 20%;
  left: 50%;
  width: 400rpx; height: 400rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114,216,196,0.28), transparent 68%);
  filter: blur(10rpx);
  animation: haloBreathe 3.4s ease-in-out infinite;
}
@keyframes haloBreathe {
  0%,100% { transform: translate(-50%,-50%) scale(0.92); opacity: 0.6; }
  50% { transform: translate(-50%,-50%) scale(1.1); opacity: 1; }
}
/* 悬浮 IP（放大为主视觉） */
.lg-ip-float {
  position: relative;
  width: 400rpx; height: 400rpx;
  display: flex; align-items: center; justify-content: center;
  z-index: 2;
}
.lg-ip-img {
  width: 100%; height: 100%;
  animation: ipFloat 3.6s ease-in-out infinite;
  filter: drop-shadow(0 18rpx 30rpx rgba(30,142,111,0.25));
}
@keyframes ipFloat {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-22rpx); }
}
/* 核心标语区 */
.lg-slogan {
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #123C33;
  letter-spacing: 4rpx;
  z-index: 2;
  text-align: center;
}
.lg-slogan-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6B8F82;
  letter-spacing: 3rpx;
  z-index: 2;
  text-align: center;
}

/* ===== 极简交互落脚点 ===== */
.lg-footer {
  padding-bottom: 64rpx;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}
/* ---- 玻璃质感装饰圆（相机 + 叶子 + 灵狐） ---- */
.lg-glass-orb {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  margin-top: 60rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.7), rgba(200,235,225,0.3) 50%, rgba(160,210,195,0.2) 100%);
  border: 2rpx solid rgba(255,255,255,0.6);
  box-shadow:
    0 12rpx 32rpx rgba(46,196,182,0.15),
    inset 0 4rpx 12rpx rgba(255,255,255,0.6),
    inset 0 -4rpx 12rpx rgba(46,196,182,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  animation: orbFloat 4s ease-in-out infinite;
}
@keyframes orbFloat {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.orb-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  position: relative;
}
.orb-icon {
  font-size: 44rpx;
  opacity: 0.9;
}
.orb-cam {
  transform: translateY(-8rpx);
}
.orb-leaf {
  transform: translateY(6rpx);
}
.orb-fox {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(255,255,255,0.7);
  box-shadow: 0 4rpx 10rpx rgba(46,196,182,0.2);
}
.orb-shine {
  position: absolute;
  top: 15%;
  left: 20%;
  width: 50rpx;
  height: 30rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255,255,255,0.8), transparent 70%);
  pointer-events: none;
}

/* ---- 纯净微信登录按钮（单一高光胶囊） ---- */
.lg-auth-btn {
  position: relative;
  width: 100%;
  height: 88rpx;
  border-radius: 26px;
  background: linear-gradient(135deg, #2EC4B6 0%, #209E92 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  overflow: hidden;
  box-shadow:
    0 12rpx 28rpx rgba(46,196,182,0.32),
    inset 0 2rpx 0 rgba(255,255,255,0.35);
  border: 1rpx solid rgba(255,255,255,0.35);
  margin-top: 44rpx;
}
.lg-auth-btn::before {
  content: '';
  position: absolute; inset: 0;
  border-radius: 26px;
  padding: 2rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.6), transparent 40%, rgba(255,255,255,0.3));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}
.lg-wechat-ico {
  width: 44rpx; height: 44rpx;
  position: relative; z-index: 2;
}
.wc-bubble {
  position: absolute;
  background: #fff;
}
.wc-b1 {
  width: 26rpx; height: 22rpx;
  border-radius: 10rpx;
  left: 2rpx; top: 4rpx;
  transform: rotate(-8deg);
}
.wc-b2 {
  width: 26rpx; height: 22rpx;
  border-radius: 10rpx;
  right: 2rpx; bottom: 4rpx;
  transform: rotate(-8deg);
  opacity: 0.92;
}
.wc-eye {
  position: absolute;
  width: 5rpx; height: 5rpx;
  border-radius: 50%;
  background: #13A89A;
}
.wc-e1 { left: 8rpx; top: 9rpx; }
.wc-e2 { right: 8rpx; top: 9rpx; }
.lg-auth-txt {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 3rpx;
  position: relative; z-index: 2;
}
.lg-auth-shine {
  position: absolute; top: -40rpx; left: -40%;
  width: 56%; height: 200%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.35), transparent);
  transform: rotate(20deg);
  animation: authShine 3s ease-in-out infinite;
  z-index: 1;
}
@keyframes authShine {
  0% { left: -60%; }
  60%,100% { left: 140%; }
}
.lg-auth-btn--press { transform: scale(0.97); }

/* 协议勾选 */
.lg-agree {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}
.lg-agree-box {
  width: 32rpx; height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(46,196,182,0.5);
  background: rgba(255,255,255,0.6);
  display: flex; align-items: center; justify-content: center;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.lg-agree-box.on {
  background: linear-gradient(135deg, #2EC4B6, #209E92);
  border-color: transparent;
}
.lg-agree-check { color: #fff; font-size: 20rpx; font-weight: 700; }
.lg-agree-text { font-size: 22rpx; color: #8BA89F; }
.lg-agree-link { font-size: 22rpx; color: #2E8B7A; font-weight: 600; }
