/* pages/login/login.wxss · 晨曦微光中的心灵引力场（极简高定登录） */

.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #EBF5F1 0%, #D4EBE3 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
}

/* ===== 流动光影氛围层 ===== */
.lg-aura {
  position: fixed;
  border-radius: 50%;
  filter: blur(70rpx);
  pointer-events: none;
  z-index: 0;
}
.aura-1 {
  width: 620rpx; height: 620rpx;
  left: -180rpx; top: -140rpx;
  background: radial-gradient(circle, rgba(96,205,180,0.5), transparent 72%);
  animation: auraFloat 9s ease-in-out infinite;
}
.aura-2 {
  width: 560rpx; height: 560rpx;
  right: -160rpx; top: 30%;
  background: radial-gradient(circle, rgba(255,250,240,0.9), transparent 72%);
  animation: auraFloat 12s ease-in-out infinite reverse;
}
.aura-3 {
  width: 700rpx; height: 700rpx;
  left: 12%; bottom: -200rpx;
  background: radial-gradient(circle, rgba(120,224,200,0.4), transparent 72%);
  animation: auraFloat 14s ease-in-out infinite;
}
@keyframes auraFloat {
  0%,100% { transform: translate(0,0) scale(1); opacity: 0.9; }
  50% { transform: translate(26rpx,-30rpx) scale(1.06); opacity: 0.55; }
}
/* 细腻噪点（杂志纸感） */
.lg-grain {
  position: fixed; inset: 0;
  background-image: radial-gradient(rgba(20,60,50,0.05) 1px, transparent 1px);
  background-size: 24rpx 24rpx;
  opacity: 0.5;
  pointer-events: none; z-index: 0;
}
/* 顶部微光斜射 */
.lg-lights {
  position: fixed;
  pointer-events: none; z-index: 0;
  opacity: 0.7;
}
.light-1 {
  width: 500rpx; height: 260rpx;
  left: -120rpx; top: 8%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.55), transparent);
  transform: rotate(-18deg);
  filter: blur(30rpx);
  animation: lightShift 8s ease-in-out infinite;
}
.light-2 {
  width: 420rpx; height: 220rpx;
  right: -100rpx; top: 42%;
  background: linear-gradient(100deg, transparent, rgba(190,255,235,0.5), transparent);
  transform: rotate(14deg);
  filter: blur(26rpx);
  animation: lightShift 10s ease-in-out infinite reverse;
}
@keyframes lightShift {
  0%,100% { transform: rotate(-18deg) translateX(0); opacity: 0.6; }
  50% { transform: rotate(-18deg) translateX(40rpx); opacity: 0.9; }
}

/* ===== 核心视觉焦点 ===== */
.lg-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  padding-top: 60rpx;
}
/* IP 呼吸光晕 */
.lg-halo {
  position: absolute;
  top: 26%;
  left: 50%;
  width: 440rpx; height: 440rpx;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114,216,196,0.28), transparent 68%);
  filter: blur(10rpx);
  animation: haloBreathe 3.4s ease-in-out infinite;
}
@keyframes haloBreathe {
  0%,100% { transform: translate(-50%,-50%) scale(0.92); opacity: 0.6; }
  50% { transform: translate(-50%,-50%) scale(1.1); opacity: 1; }
}
.lg-ip-float {
  position: relative;
  width: 340rpx; height: 340rpx;
  display: flex; align-items: center; justify-content: center;
  z-index: 2;
}
.lg-ip-img {
  width: 100%; height: 100%;
  animation: ipFloat 3.6s ease-in-out infinite;
  filter: drop-shadow(0 18rpx 30rpx rgba(30,142,111,0.25));
}
@keyframes ipFloat {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-22rpx); }
}
/* 品牌标语 */
.lg-slogan {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #123C33;
  letter-spacing: 4rpx;
  z-index: 2;
}
.lg-slogan-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6B8F82;
  letter-spacing: 3rpx;
  z-index: 2;
}

/* ===== 极简交互落脚点 ===== */
.lg-footer {
  padding-bottom: 70rpx;
  position: relative;
  z-index: 1;
}
/* 高定授权主按钮 */
.lg-auth-btn {
  position: relative;
  width: 100%;
  height: 116rpx;
  border-radius: 32px;
  background: linear-gradient(135deg, #2EC4B6 0%, #209E92 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  overflow: hidden;
  box-shadow:
    0 16rpx 36rpx rgba(46,196,182,0.35),
    inset 0 2rpx 0 rgba(255,255,255,0.35);
  border: 1rpx solid rgba(255,255,255,0.35);
}
.lg-auth-btn::before {
  content: '';
  position: absolute; inset: 0;
  border-radius: 32px;
  padding: 2rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.6), transparent 40%, rgba(255,255,255,0.3));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}
.lg-auth-ico { font-size: 34rpx; position: relative; z-index: 2; }
.lg-auth-texts { display: flex; flex-direction: column; align-items: flex-start; position: relative; z-index: 2; }
.lg-auth-main { font-size: 32rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; line-height: 1.3; }
.lg-auth-sub { font-size: 20rpx; color: rgba(255,255,255,0.8); letter-spacing: 1rpx; }
.lg-auth-shine {
  position: absolute; top: -40rpx; left: -40%;
  width: 56%; height: 200%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.35), transparent);
  transform: rotate(20deg);
  animation: authShine 3s ease-in-out infinite;
  z-index: 1;
}
@keyframes authShine {
  0% { left: -60%; }
  60%,100% { left: 140%; }
}
.lg-auth-btn--press { transform: scale(0.97); }

/* 协议勾选 */
.lg-agree {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
}
.lg-agree-box {
  width: 32rpx; height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(46,196,182,0.5);
  background: rgba(255,255,255,0.6);
  display: flex; align-items: center; justify-content: center;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.lg-agree-box.on {
  background: linear-gradient(135deg, #2EC4B6, #209E92);
  border-color: transparent;
}
.lg-agree-check { color: #fff; font-size: 20rpx; font-weight: 700; }
.lg-agree-text { font-size: 22rpx; color: #8BA89F; }
.lg-agree-link { font-size: 22rpx; color: #2E8B7A; font-weight: 600; }
