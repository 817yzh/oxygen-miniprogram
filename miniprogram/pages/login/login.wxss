/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EAFBF6 0%, #F8FBFA 45%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
}

/* ===== 顶部氛围区 ===== */
.hero {
  position: relative;
  height: 62vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 漂浮气泡 */
.bubble {
  position: absolute;
  border-radius: 50%;
  opacity: 0.45;
}
.b1 { width: 140rpx; height: 140rpx; background: #72D8C4; top: 8%; left: 12%; animation: float 6s ease-in-out infinite; }
.b2 { width: 70rpx; height: 70rpx; background: #B8E8FF; top: 22%; right: 16%; animation: float 5s ease-in-out 0.5s infinite; }
.b3 { width: 100rpx; height: 100rpx; background: #A6E6C0; bottom: 18%; left: 18%; animation: float 7s ease-in-out 1s infinite; }
.b4 { width: 50rpx; height: 50rpx; background: #FF9F43; bottom: 30%; right: 22%; opacity: 0.35; animation: float 5.5s ease-in-out 0.8s infinite; }

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-24rpx); }
}

/* IP 狐狸 */
.ip-wrap {
  position: relative;
  z-index: 2;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.75);
  box-shadow: 0 20rpx 60rpx rgba(114,216,196,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}
.ip-img {
  width: 260rpx;
  height: 260rpx;
}

/* 品牌 */
.brand {
  position: relative;
  z-index: 2;
  text-align: center;
}
.brand-name {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #1E8E7A;
  letter-spacing: 4rpx;
}
.brand-slogan {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8AA0A0;
  letter-spacing: 2rpx;
}

/* ===== 底部登录卡片 ===== */
.login-card {
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 40rpx rgba(114,216,196,0.12);
}

/* 特性三宫格 */
.feature-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 48rpx;
}
.feature {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.feature-ico { font-size: 48rpx; }
.feature-txt { margin-top: 12rpx; font-size: 24rpx; color: #8AA0A0; }

/* 主按钮 */
.btn--block { width: 100%; }
.login-btn {
  height: 96rpx;
  background: linear-gradient(135deg, #72D8C4 0%, #4EC6AE 100%);
  border-radius: 999px;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 32rpx rgba(78,198,174,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
.login-btn::after { border: none; }
.login-btn-text { color: #FFFFFF; }

/* 协议 */
.agreement {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9BB0AC;
}
.agree-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #cfd8d6;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}
.agree-check.on {
  background: #72D8C4;
  border-color: #72D8C4;
}
.link {
  color: #4EC6AE;
  margin: 0 4rpx;
}

/* 底部说明 */
.foot-note {
  position: absolute;
  bottom: 24rpx;
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: #C0D0CC;
}
