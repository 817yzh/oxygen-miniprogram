<!-- pages/login/login.wxml · 晨曦微光心灵引力场（高定纯净版：大背景 + 大IP + 单按钮） -->
<view class="login-page">

  <!-- ===== 全屏晨曦微光渐变背景 + 流动光影 ===== -->
  <view class="lg-aura aura-1"></view>
  <view class="lg-aura aura-2"></view>
  <view class="lg-aura aura-3"></view>
  <view class="lg-grain"></view>
  <view class="lg-lights light-1"></view>
  <view class="lg-lights light-2"></view>

  <!-- ===== 全屏微光悬浮粒子（氧气泡泡） ===== -->
  <view class="lg-bubble-lg bubble-p1"></view>
  <view class="lg-bubble-lg bubble-p2"></view>
  <view class="lg-bubble-lg bubble-p3"></view>
  <view class="lg-bubble-sm bubble-p4"></view>
  <view class="lg-bubble-sm bubble-p5"></view>
  <view class="lg-bubble-sm bubble-p6"></view>

  <!-- ===== 顶部主视觉 ===== -->
  <view class="lg-hero">
    <!-- 呼呼身后 · 超大晨曦薄荷呼吸光晕 -->
    <view class="lg-back-glow"></view>

    <!-- 悬浮 IP（放大为主视觉） -->
    <view class="lg-halo"></view>
    <view class="lg-ip-float">
      <image
        class="lg-ip-img"
        src="https://cdn.jsdelivr.net/gh/817yzh/oxygen-images@main/oxy-ip.png"
        mode="aspectFit"
      />
    </view>

    <!-- 核心标语区 -->
    <text class="lg-slogan">吸一口气，开启美好能量</text>
    <text class="lg-slogan-sub">把生活风浪，交给呼呼守护</text>

    <!-- 微光地平线（填充留白） -->
    <view class="lg-horizon">
      <view class="lg-hz-line"></view>
      <view class="lg-hz-dot d1"></view>
      <view class="lg-hz-dot d2"></view>
      <view class="lg-hz-dot d3"></view>
    </view>
  </view>

  <!-- ===== 极简交互落脚点 ===== -->
  <view class="lg-footer">
    <!-- 纯净微信登录按钮（单一高光胶囊 + 白色微信图标） -->
    <view class="lg-auth-btn" bindtap="onWechatLogin" hover-class="lg-auth-btn--press">
      <view class="lg-auth-shine"></view>
      <image
        class="lg-wechat-ico"
        src="data:image/svg+xml;base64,"
      />
      <text class="lg-auth-txt">微信登录</text>
    </view>

    <!-- 协议勾选 -->
    <view class="lg-agree" bindtap="toggleAgree">
      <view class="lg-agree-box {{agreed ? 'on' : ''}}">
        <text wx:if="{{agreed}}" class="lg-agree-check">✓</text>
      </view>
      <text class="lg-agree-text">登录即代表同意</text>
      <text class="lg-agree-link" catchtap="showAgree">《用户协议》</text>
      <text class="lg-agree-text">和</text>
      <text class="lg-agree-link" catchtap="showPrivacy">《隐私政策》</text>
    </view>
  </view>

</view>
