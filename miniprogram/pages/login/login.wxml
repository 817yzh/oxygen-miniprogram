<!-- 登录页 · 氧氧宝 -->
<view class="login-page">

  <!-- 顶部氛围区：渐变 + 漂浮气泡 + IP -->
  <view class="hero">
    <!-- 漂浮气泡装饰 -->
    <view class="bubble b1"></view>
    <view class="bubble b2"></view>
    <view class="bubble b3"></view>
    <view class="bubble b4"></view>

    <!-- IP 狐狸 -->
    <view class="ip-wrap">
      <image class="ip-img" src="https://cdn.jsdelivr.net/gh/817yzh/oxygen-images@main/oxy-ip.png" mode="aspectFit" />
    </view>

    <!-- 品牌 -->
    <view class="brand">
      <text class="brand-name">氧氧宝</text>
      <text class="brand-slogan">连接身体与内心的氧气伙伴</text>
    </view>
  </view>

  <!-- 底部登录卡片 -->
  <view class="login-card">
    <view class="feature-row">
      <view class="feature col-3">
        <text class="feature-ico">💚</text>
        <text class="feature-txt">情绪感知</text>
      </view>
      <view class="feature col-3">
        <text class="feature-ico">🤖</text>
        <text class="feature-txt">AI 陪伴</text>
      </view>
      <view class="feature col-3">
        <text class="feature-ico">🌱</text>
        <text class="feature-txt">自我成长</text>
      </view>
    </view>

    <button class="btn btn--primary btn--block login-btn" bindtap="onWechatLogin">
      <text class="login-btn-text">微信一键登录</text>
    </button>

    <view class="agreement">
      <view class="agree-check {{agreed?'on':''}}" bindtap="toggleAgree">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <text class="aux">我已阅读并同意</text>
      <text class="link" bindtap="showAgree">《用户协议》</text>
      <text class="aux">和</text>
      <text class="link" bindtap="showPrivacy">《隐私政策》</text>
    </view>
  </view>

  <view class="foot-note">用 30 秒认识你 · 从发现今天的氧气开始</view>

</view>
