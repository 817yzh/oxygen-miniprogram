/* Page 4 · AI分析动画页 */
.mbti-loading {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 18%, rgba(184,232,255,0.5) 0%, transparent 50%),
    radial-gradient(circle at 30% 80%, rgba(114,216,196,0.2) 0%, transparent 45%),
    var(--yy-bg);
  padding-top: 80px;
  box-sizing: border-box;
}

.phase-text { font-size: 16px; font-weight: 600; color: var(--yy-text); }

.loading-dots { }
.dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: rgba(184,232,255,0.6);
  transition: all 0.3s;
}
.dot.on {
  background: var(--yy-primary);
  transform: scale(1.2);
  box-shadow: 0 0 8px rgba(114,216,196,0.6);
}

/* 背景流动粒子 */
.mbti-loading::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(114,216,196,0.12) 0 12px, transparent 13px),
    radial-gradient(circle at 80% 60%, rgba(184,232,255,0.25) 0 18px, transparent 19px),
    radial-gradient(circle at 50% 90%, rgba(114,216,196,0.1) 0 10px, transparent 11px);
  animation: drift 6s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}
@keyframes drift {
  0%, 100% { opacity: 0.6; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-12px); }
}
