/* 氧气档案页 */
.oprofile {
  background:
    radial-gradient(circle at 85% 5%, rgba(114,216,196,0.2) 0%, transparent 45%),
    radial-gradient(circle at 10% 15%, rgba(184,232,255,0.4) 0%, transparent 45%),
    var(--yy-bg);
}
.op-hero { padding-top: 8px; }

.persona-card { text-align: center; }
.op-icon { font-size: 54px; }
.persona-desc { line-height: 1.7; padding: 0 8px; }

.section-title { margin: 24px 4px 12px; }

.tag-item {
  padding: 14px 4px;
  border-bottom: 1px solid rgba(184,232,255,0.3);
}
.tag-item:last-child { border-bottom: none; }
.tag-label { min-width: 76px; }
.tag-value { font-size: 15px; font-weight: 600; text-align: right; }

.mood-card { }
.mood-row {
  padding: 10px 4px;
  font-size: 15px;
}
.mood-up { color: var(--yy-accent); font-weight: 700; }

.op-footer { color: #b8cbc9; }

/* V0.8 升级新增样式 */
.mt-16 { margin-top: 16px; }

/* 基础信息卡 */
.base-card { align-items: center; gap: 14px; }
.base-avatar {
  width: 52px; height: 52px; border-radius: 999px;
  background: linear-gradient(135deg, #72D8C4, #B8E8FF);
  flex-shrink: 0;
}
.base-avatar-img { width: 100%; height: 100%; border-radius: 999px; }
.base-avatar-emoji { font-size: 24px; }
.base-name { font-size: 18px; font-weight: 800; color: var(--yy-text); }
.base-tag {
  font-size: 11px; color: #2BB696; background: rgba(114,216,196,0.15);
  border-radius: 999px; padding: 2rpx 12rpx; white-space: nowrap;
}
.base-days { font-size: 12px; }
.base-growth { font-size: 12px; color: var(--yy-primary); }

/* 人格补充按钮 */
.btn--sm { min-width: 0; padding: 8rpx 28rpx; font-size: 13px; height: auto; line-height: 1.8; }

/* 场景偏好 */
.scene-prefs { flex-wrap: wrap; }
.scene-chip {
  display: flex; align-items: center; gap: 6px;
  padding: 12rpx 22rpx; border-radius: 999px;
  background: rgba(114,216,196,0.12); color: var(--yy-text);
  font-size: 13px; font-weight: 600;
}
.scene-count { font-size: 11px; color: var(--yy-primary); }

/* 7天趋势 */
.trend-card { padding: 18rpx 20rpx; }
.trend-scroll { white-space: nowrap; }
.trend-inner { display: flex; }
.trend-day {
  min-width: 92px; padding: 14rpx 6rpx;
  background: rgba(184,232,255,0.25); border-radius: 16rpx;
  margin-right: 8rpx;
}
.trend-day:last-child { margin-right: 0; }
.trend-energy { font-size: 18px; font-weight: 800; color: #2BB696; }
.trend-label { font-size: 12px; margin-top: 4rpx; }
.trend-date { font-size: 11px; color: var(--yy-text-sub); }

.empty-card { padding: 24rpx; }
.trend-link { color: var(--yy-primary); font-weight: 600; }

/* 健康声明入口 */
.disc-card { align-items: center; gap: 12px; padding: 18rpx 22rpx; }
.disc-icon { font-size: 26px; }
.disc-arrow { color: var(--yy-primary); font-size: 18px; font-weight: 700; }
.disc-hover { opacity: 0.85; transform: scale(0.99); }
