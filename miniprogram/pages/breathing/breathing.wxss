/*
 * pages/breathing/breathing.wxss
 * V2.1 · 1分钟真吸氧沉浸页样式（修复版）
 * 修复: 背景径向渐变(透亮) / IP干净样式(防花屏) / 去掉自定义顶部
 */

.breathing-page {
  min-height: 100vh;
  /* 中心发光径向渐变：深林绿 + 微光，透亮不沉闷 */
  background: radial-gradient(circle at 50% 42%, #2A6050 0%, #14332A 55%, #071510 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* ========== 阶段1：设备唤醒 ========== */
.stage-wakeup {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
  /* 唤醒阶段专用背景：中心微光的深墨绿径向渐变（不沉闷） */
  background: radial-gradient(circle at 50% 45%, #1D4A3E 0%, #0C211A 60%, #05120D 100%);
}

.stage-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  margin-bottom: 80rpx;
}

/* 呼吸光晕环 */
.glow-ring {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114, 216, 196, 0.25) 0%, rgba(114, 216, 196, 0) 70%);
  animation: breatheGlow 3s ease-in-out infinite;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

@keyframes breatheGlow {
  0%, 100% { transform: translate(-50%, -50%) scale(0.9); opacity: 0.5; }
  50% { transform: translate(-50%, -50%) scale(1.15); opacity: 0.9; }
}

/* IP底部柔和呼吸光晕（设备充氧氛围感） */
.ip-glow {
  position: absolute;
  width: 360rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(114, 216, 196, 0.45) 0%, rgba(114, 216, 196, 0.15) 50%, transparent 70%);
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
  animation: ipGlowBreathe 4s ease-in-out infinite;
  filter: blur(8rpx);
}

@keyframes ipGlowBreathe {
  0%, 100% { transform: translateX(-50%) scale(0.9); opacity: 0.6; }
  50% { transform: translateX(-50%) scale(1.15); opacity: 1; }
}

/* IP：高清透明原图 + 绿光投影(立体感)，绝不用滤镜/背景色，防“膏药”感 */
.stage-ip {
  width: 340rpx;
  height: 340rpx;
  position: relative;
  z-index: 2;
  margin-bottom: 40rpx;
  /* 透明PNG悬浮：加一层极轻绿色高光阴影，立体感拉满 */
  filter: drop-shadow(0 10rpx 25rpx rgba(50, 169, 139, 0.35));
}

.stage-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}

.stage-main-text {
  font-size: 28rpx;
  color: #A8E6D5;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.stage-sub-text {
  font-size: 24rpx;
  color: #6B9E90;
  margin-bottom: 24rpx;
}

/* 三点波浪加载 */
.loading-dots {
  display: flex;
  gap: 12rpx;
  justify-content: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #32A98B;
  border-radius: 50%;
  animation: dotPulse 1.4s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.stage-footer {
  font-size: 22rpx;
  color: #4A7A6E;
  letter-spacing: 2rpx;
}

/* ========== 阶段2：呼吸沉浸 ========== */
.stage-breathing {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
}

.breath-ring-area {
  width: 500rpx;
  height: 500rpx;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 60rpx;
}

.breath-ring-outer {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114, 216, 196, 0.15) 0%, transparent 70%);
  transition: all 1s ease;
}

.breath-ring-main {
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.12) 0%, rgba(114,216,196,0.08) 50%, rgba(114,216,196,0.05) 100%);
  border: 2rpx solid rgba(114, 216, 196, 0.3);
  box-shadow: 0 0 60rpx rgba(114, 216, 196, 0.2), inset 0 0 40rpx rgba(114, 216, 196, 0.1);
  display: flex;
  justify-content: center;
  align-items: center;
  transition: transform 1s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 1s ease;
}

.breath-ring-inner { display: flex; flex-direction: column; align-items: center; }
.breath-phase { font-size: 44rpx; color: #72D8C4; font-weight: 300; letter-spacing: 8rpx; margin-bottom: 16rpx; }
.breath-countdown { font-size: 72rpx; color: rgba(255, 255, 255, 0.95); font-weight: 200; line-height: 1; margin-bottom: 12rpx; }
.breath-hint { font-size: 24rpx; color: rgba(255, 255, 255, 0.4); letter-spacing: 2rpx; }

/* 三阶段呼吸动效 */
.breath-ring-main.phase-inhale {
  transform: scale(1.25);
  box-shadow: 0 0 100rpx rgba(114, 216, 196, 0.4), inset 0 0 60rpx rgba(114, 216, 196, 0.15);
}
.breath-ring-outer.phase-inhale {
  transform: scale(1.3);
  background: radial-gradient(circle, rgba(114, 216, 196, 0.25) 0%, transparent 70%);
}
.breath-ring-main.phase-hold {
  transform: scale(1.25);
  box-shadow: 0 0 80rpx rgba(150, 220, 200, 0.35), inset 0 0 50rpx rgba(150, 220, 200, 0.12);
  border-color: rgba(150, 220, 200, 0.4);
}
.breath-ring-main.phase-exhale {
  transform: scale(0.9);
  box-shadow: 0 0 40rpx rgba(114, 216, 196, 0.15), inset 0 0 30rpx rgba(114, 216, 196, 0.08);
}
.breath-ring-outer.phase-exhale {
  transform: scale(0.95);
  background: radial-gradient(circle, rgba(114, 216, 196, 0.1) 0%, transparent 70%);
}

/* 水波粒子 */
.water-particle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.6) 0%, rgba(114,216,196,0.2) 100%);
  pointer-events: none;
}
.p1 { width: 12rpx; height: 12rpx; top: 20%; left: 25%; animation: particleFloat 6s ease-in-out infinite; }
.p2 { width: 8rpx; height: 8rpx; top: 30%; right: 20%; animation: particleFloat 5s ease-in-out infinite 1s; }
.p3 { width: 16rpx; height: 16rpx; bottom: 25%; left: 20%; animation: particleFloat 7s ease-in-out infinite 0.5s; }
.p4 { width: 10rpx; height: 10rpx; bottom: 30%; right: 25%; animation: particleFloat 5.5s ease-in-out infinite 1.5s; }
.p5 { width: 6rpx; height: 6rpx; top: 45%; left: 15%; animation: particleFloat 4.5s ease-in-out infinite 2s; }
.p6 { width: 14rpx; height: 14rpx; top: 50%; right: 15%; animation: particleFloat 6.5s ease-in-out infinite 0.8s; }

@keyframes particleFloat {
  0%, 100% { transform: translateY(0) translateX(0); opacity: 0.3; }
  50% { transform: translateY(-30rpx) translateX(10rpx); opacity: 0.8; }
}

/* 总倒计时 */
.total-timer { display: flex; flex-direction: column; align-items: center; margin-bottom: 32rpx; }
.timer-label { font-size: 22rpx; color: rgba(255, 255, 255, 0.4); letter-spacing: 4rpx; margin-bottom: 8rpx; }
.timer-value { font-size: 48rpx; color: rgba(255, 255, 255, 0.8); font-weight: 200; }

/* 硬件状态 */
.device-status {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: rgba(114, 216, 196, 0.1);
  border-radius: 32rpx;
  border: 1rpx solid rgba(114, 216, 196, 0.2);
}
.device-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #72D8C4;
  margin-right: 12rpx; animation: devicePulse 2s ease-in-out infinite;
}
@keyframes devicePulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 8rpx #72D8C4; }
  50% { opacity: 0.5; box-shadow: 0 0 16rpx #72D8C4; }
}
.device-text { font-size: 24rpx; color: rgba(255, 255, 255, 0.6); letter-spacing: 1rpx; }

/* ========== 阶段3：充氧报告卡 ========== */
.stage-result {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 48rpx 60rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.result-ip {
  width: 280rpx;
  height: 280rpx;
  margin-bottom: 24rpx;
  animation: resultBounce 1.5s ease-in-out infinite;
}

@keyframes resultBounce {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-12rpx) scale(1.05); }
}

.result-title { font-size: 44rpx; color: #72D8C4; font-weight: 600; letter-spacing: 4rpx; margin-bottom: 12rpx; }
.result-sub { font-size: 26rpx; color: rgba(255, 255, 255, 0.5); margin-bottom: 40rpx; letter-spacing: 1rpx; }

.result-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.result-main { display: flex; flex-direction: column; align-items: center; padding-bottom: 32rpx; }
.result-main-label { font-size: 26rpx; color: rgba(255, 255, 255, 0.5); letter-spacing: 4rpx; margin-bottom: 20rpx; }
.result-main-compare { display: flex; align-items: center; gap: 24rpx; margin-bottom: 16rpx; }
.result-before { font-size: 56rpx; color: rgba(255, 255, 255, 0.4); font-weight: 300; }
.result-arrow { font-size: 36rpx; color: #72D8C4; }
.result-after { font-size: 72rpx; color: #72D8C4; font-weight: 500; }
.result-gain { font-size: 26rpx; color: #72D8C4; background: rgba(114, 216, 196, 0.15); padding: 8rpx 24rpx; border-radius: 20rpx; letter-spacing: 2rpx; }

.result-divider { width: 100%; height: 1rpx; background: rgba(255, 255, 255, 0.1); margin: 24rpx 0; }

.result-hardware { display: flex; flex-direction: column; gap: 24rpx; }
.hw-item { display: flex; align-items: center; }
.hw-icon { font-size: 36rpx; width: 56rpx; text-align: center; }
.hw-label { flex: 1; font-size: 28rpx; color: rgba(255, 255, 255, 0.7); margin-left: 16rpx; }
.hw-compare { display: flex; align-items: center; gap: 12rpx; }
.hw-before { font-size: 26rpx; color: rgba(255, 255, 255, 0.4); }
.hw-arrow { font-size: 24rpx; color: rgba(255, 255, 255, 0.4); }
.hw-after { font-size: 30rpx; color: #72D8C4; font-weight: 500; }

.result-encourage { font-size: 26rpx; color: rgba(255, 255, 255, 0.6); text-align: center; line-height: 1.6; margin-bottom: 40rpx; padding: 0 20rpx; }

.result-btn {
  width: 100%;
  max-width: 560rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #2BA882 0%, #1E8E6F 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(30, 142, 111, 0.35);
}
.result-btn text { font-size: 30rpx; color: #FFFFFF; letter-spacing: 4rpx; font-weight: 500; }
