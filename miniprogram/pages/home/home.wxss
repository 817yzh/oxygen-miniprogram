/*
 * pages/home/home.wxss
 * V2.1 · 高质感治愈首页样式
 * 核心: 清透渐变背景 / IP物理趴球 / 玻璃拟态球+内部粒子 / 微光气泡 / 维度气泡弹出
 */

/* ========== 页面容器（清透渐变，告别土黄） ========== */
.home-v2 {
  min-height: 100vh;
  /* 晨曦绿 → 极光白，三段渐变，透亮有呼吸感 */
  background: linear-gradient(180deg, #EBF8F5 0%, #F5FBF9 50%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ========== 0. 品牌视频位（config 配置 URL 后展示；默认隐藏，零布局影响） ========== */
.intro-video {
  width: 100%;
  height: 280rpx;
  border-radius: 28rpx;
  margin-top: 24rpx;
  overflow: hidden;
  position: relative;
  z-index: 6;
  background: #0A3D30;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.15);
}

.intro-video-el {
  width: 100%;
  height: 100%;
}

.intro-video-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* ========== 1. 顶部问候区 ========== */
.greeting-area {
  width: 100%;
  padding-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  z-index: 5;
}

.greeting-title {
  font-size: 52rpx;
  font-weight: 600;
  color: #2B5B52;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.greeting-sub {
  font-size: 26rpx;
  color: #8BA89F;
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ========== 2. 主视觉区（IP + 球体 + 气泡） ========== */
.main-stage {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  min-height: 560rpx;
}

/* --- 装饰微光气泡（背景层，拉出前后纵深感） --- */
.glow-bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114, 216, 196, 0.2) 0%, rgba(114, 216, 196, 0.05) 70%, transparent 100%);
  pointer-events: none;
}

.bubble-1 {
  width: 120rpx;
  height: 120rpx;
  top: 15%;
  left: 8%;
  animation: floatBubble 6s ease-in-out infinite;
}

.bubble-2 {
  width: 80rpx;
  height: 80rpx;
  top: 25%;
  right: 12%;
  animation: floatBubble 5s ease-in-out infinite 1s;
}

.bubble-3 {
  width: 100rpx;
  height: 100rpx;
  bottom: 20%;
  left: 15%;
  animation: floatBubble 7s ease-in-out infinite 0.5s;
}

/* 微光气泡缓慢浮动 */
@keyframes floatBubble {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.6; }
  50% { transform: translateY(-20rpx) scale(1.1); opacity: 0.9; }
}

/* --- IP形象：物理趴在球顶（放大+重叠+阴影） --- */
.ip-avatar {
  width: 320rpx;
  height: 320rpx;
  position: relative;
  z-index: 2;  /* 压在球体上方 */
  margin-bottom: -130rpx;  /* 向下挤压，实现趴在球上的实体落脚感 */
  filter: drop-shadow(0 8rpx 16rpx rgba(114, 216, 196, 0.3));
  animation: ipFloat 4s ease-in-out infinite;
}

/* IP上下微幅浮动，与球体呼吸同步 */
@keyframes ipFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

/* 点击IP时的Q弹反馈 */
@keyframes ipBounce {
  0% { transform: scale(1); }
  40% { transform: scale(1.2) rotate(5deg); }
  70% { transform: scale(0.95) rotate(-3deg); }
  100% { transform: scale(1); }
}

.ip-tap-active {
  animation: ipBounce 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
}

/* --- 治愈气泡（点击IP后弹出） --- */
.comfort-bubble {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%) translateY(20rpx);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 28rpx;
  padding: 20rpx 32rpx;
  max-width: 480rpx;
  font-size: 26rpx;
  color: #2B5B52;
  line-height: 1.6;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(114, 216, 196, 0.2);
  opacity: 0;
  z-index: 20;
  pointer-events: none;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.comfort-bubble::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 14rpx solid rgba(255, 255, 255, 0.95);
}

.bubble-show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* --- 玻璃氧气球（核心视觉） --- */
.oxygen-ball {
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  /* 玻璃拟态：左上高光 → 中心薄荷绿 → 边缘淡蓝 */
  background: radial-gradient(
    circle at 35% 35%,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(168, 230, 207, 0.4) 40%,
    rgba(114, 216, 196, 0.25) 70%,
    rgba(150, 210, 230, 0.15) 100%
  );
  /* 外发光 + 内发光 */
  box-shadow:
    0 20rpx 60rpx rgba(114, 216, 196, 0.25),
    0 8rpx 24rpx rgba(114, 216, 196, 0.15),
    inset 0 0 30rpx rgba(255, 255, 255, 0.8),
    inset 0 -10rpx 30rpx rgba(114, 216, 196, 0.1);
  backdrop-filter: blur(12px);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
}

.ball-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.ball-number {
  font-size: 100rpx;
  font-weight: 300;
  color: #2B5B52;
  line-height: 1;
  letter-spacing: -4rpx;
}

.ball-label {
  font-size: 24rpx;
  color: #8BA89F;
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

.ball-slogan {
  font-size: 22rpx;
  color: #A8C5BC;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
  opacity: 0.8;
}

/* 球内气泡粒子（缓慢上升，让球"活"起来） */
.inner-particle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.2) 100%);
  pointer-events: none;
}

.particle-1 {
  width: 16rpx;
  height: 16rpx;
  left: 30%;
  bottom: 20%;
  animation: particleRise 5s ease-in-out infinite;
}

.particle-2 {
  width: 12rpx;
  height: 12rpx;
  left: 55%;
  bottom: 15%;
  animation: particleRise 6s ease-in-out infinite 1s;
}

.particle-3 {
  width: 20rpx;
  height: 20rpx;
  left: 40%;
  bottom: 25%;
  animation: particleRise 7s ease-in-out infinite 0.5s;
}

.particle-4 {
  width: 10rpx;
  height: 10rpx;
  left: 65%;
  bottom: 18%;
  animation: particleRise 5.5s ease-in-out infinite 1.5s;
}

/* 粒子缓慢上升到顶部后消失，循环 */
@keyframes particleRise {
  0% { transform: translateY(0); opacity: 0; }
  10% { opacity: 0.8; }
  90% { opacity: 0.6; }
  100% { transform: translateY(-280rpx); opacity: 0; }
}

/* 呼吸缩放动画 */
@keyframes breathe {
  0%, 100% {
    transform: scale(1);
    box-shadow:
      0 20rpx 60rpx rgba(114, 216, 196, 0.25),
      0 8rpx 24rpx rgba(114, 216, 196, 0.15),
      inset 0 0 30rpx rgba(255, 255, 255, 0.8),
      inset 0 -10rpx 30rpx rgba(114, 216, 196, 0.1);
  }
  50% {
    transform: scale(1.05);
    box-shadow:
      0 30rpx 80rpx rgba(114, 216, 196, 0.35),
      0 12rpx 32rpx rgba(114, 216, 196, 0.2),
      inset 0 0 40rpx rgba(255, 255, 255, 0.9),
      inset 0 -10rpx 30rpx rgba(114, 216, 196, 0.15);
  }
}

.breathing {
  animation: breathe 4s ease-in-out infinite;
}

/* --- 维度气泡（点击球体后弹出，4个围绕球体） --- */
.dim-bubbles {
  position: absolute;
  width: 460rpx;  /* 和球体同大 */
  height: 460rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 3;
}

.dim-bubble {
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  /* 玻璃拟态：左上高光 → 中心半透白 → 边缘薄荷绿淡光 */
  background: radial-gradient(
    circle at 30% 25%,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(255, 255, 255, 0.7) 35%,
    rgba(200, 235, 225, 0.5) 65%,
    rgba(114, 216, 196, 0.3) 100%
  );
  backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  /* 外发光 + 内发光 */
  box-shadow:
    0 4rpx 16rpx rgba(114, 216, 196, 0.2),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.6),
    inset 0 -2rpx 6rpx rgba(114, 216, 196, 0.15);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  opacity: 0;
  transform: scale(0);
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

/* 4个气泡微弧形错落分布（打破机械对称，有水灵灵的自然感） */
.dim-bubble:nth-child(1) { top: -6%; left: -20%; }
.dim-bubble:nth-child(2) { top: -14%; right: -17%; }
.dim-bubble:nth-child(3) { bottom: -8%; left: -17%; }
.dim-bubble:nth-child(4) { bottom: -4%; right: -20%; }

/* 弹出时逐个延迟（stagger效果） */
.bubbles-show .dim-bubble {
  opacity: 1;
  transform: scale(1);
}
.bubbles-show .dim-bubble:nth-child(1) { transition-delay: 0s; }
.bubbles-show .dim-bubble:nth-child(2) { transition-delay: 0.08s; }
.bubbles-show .dim-bubble:nth-child(3) { transition-delay: 0.16s; }
.bubbles-show .dim-bubble:nth-child(4) { transition-delay: 0.24s; }

/* --- 氛围无字气泡（一大一小，纯半透明高光水滴） --- */
.atmosphere-bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.85) 0%, rgba(200,235,225,0.35) 50%, rgba(114,216,196,0.15) 100%);
  border: 1rpx solid rgba(255,255,255,0.5);
  opacity: 0;
  transform: scale(0);
  transition: all 0.5s ease;
  pointer-events: none;
}

.atm-big {
  width: 56rpx;
  height: 56rpx;
  top: 8%;
  right: 6%;
  animation: atmFloat 5s ease-in-out infinite 0.3s;
}

.atm-small {
  width: 32rpx;
  height: 32rpx;
  bottom: 12%;
  left: 8%;
  animation: atmFloat 4s ease-in-out infinite 0.8s;
}

/* 氛围气泡弹出 */
.bubbles-show .atmosphere-bubble {
  opacity: 0.7;
  transform: scale(1);
}
.bubbles-show .atm-big { transition-delay: 0.32s; }
.bubbles-show .atm-small { transition-delay: 0.4s; }

/* 氛围气泡轻微浮动 */
@keyframes atmFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-10rpx) scale(1.08); }
}

.dim-bubble-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.dim-bubble-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #38C0A0;
  line-height: 1;
}

.dim-bubble-label {
  font-size: 18rpx;
  color: #8BA89F;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* ========== 3. 极淡提示文字 ========== */
.ball-hint {
  font-size: 24rpx;
  color: #B8CFC7;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
  letter-spacing: 2rpx;
  opacity: 0.7;
  z-index: 5;
}

/* ========== 4. 底部吸氧按钮 ========== */
.action-area {
  width: 100%;
  padding-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  z-index: 5;
}

/* AI 陪伴 · 聊一聊 次级入口 */
.chat-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 40rpx;
  border-radius: 50rpx;
  background: rgba(255,255,255,0.7);
  border: 1.5rpx solid rgba(16,185,129,0.4);
  color: #0E7A68;
}
.chat-link-ico { font-size: 28rpx; }
.chat-link-text { font-size: 26rpx; font-weight: 600; letter-spacing: 1rpx; }

.oxygen-btn {
  width: 100%;
  max-width: 600rpx;
  height: 100rpx;
  border-radius: 50rpx;
  /* 深绿色按钮，参考设计稿 */
  background: linear-gradient(135deg, #2BA882 0%, #1E8E6F 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(30, 142, 111, 0.35);
  transition: transform 0.15s ease;
}

.btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 4rpx;
}

/* 按钮呼吸光晕 */
@keyframes btnGlow {
  0%, 100% { box-shadow: 0 8rpx 24rpx rgba(30, 142, 111, 0.35); }
  50% { box-shadow: 0 8rpx 36rpx rgba(30, 142, 111, 0.55), 0 0 20rpx rgba(30, 142, 111, 0.3); }
}

.breathing-glow {
  animation: btnGlow 3s ease-in-out infinite;
}

/* ========== 5. IP形象容器（点击可唤起记录抽屉） ========== */
.ip-wrap {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ========== 6. 今日充氧手账抽屉 ========== */
/* 遮罩层 */
.drawer-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(10, 28, 22, 0.45);
  z-index: 60;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease;
}
.drawer-mask--show {
  opacity: 1;
  visibility: visible;
}

/* 抽屉本体 */
.checkin-drawer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 70;
  background: linear-gradient(180deg, #F7FCFA 0%, #EDF8F4 100%);
  border-radius: 40rpx 40rpx 0 0;
  padding: 28rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 48rpx rgba(16, 185, 129, 0.2);
  transform: translateY(110%);
  transition: transform 0.36s cubic-bezier(0.32, 0.72, 0.32, 1);
  max-width: 520px;
  margin: 0 auto;
  box-sizing: border-box;
}
.checkin-drawer.drawer-open {
  transform: translateY(0);
}

.drawer-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999px;
  background: rgba(16, 185, 129, 0.25);
  margin: 0 auto 24rpx;
}

.drawer-title-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}
.drawer-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1F3833;
  letter-spacing: 2rpx;
}
.drawer-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7A8E88;
  letter-spacing: 1rpx;
}

/* 氧状态胶囊（Q2 五档 · 3列网格） */
.mood-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.mood-pill {
  width: calc((100% - 32rpx) / 3);
  height: 96rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(114, 216, 196, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: all 0.2s ease;
  box-sizing: border-box;
}
.mood-pill.mood-on {
  background: linear-gradient(135deg, #6FE0C6 0%, #38C0A0 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 24rpx rgba(56, 192, 160, 0.4);
  transform: translateY(-4rpx);
}
.mood-icon { font-size: 34rpx; }
.mood-text { font-size: 22rpx; color: #4A6A60; font-weight: 600; }
.mood-pill.mood-on .mood-text { color: #fff; }

/* 氧气瞬间照片（可选）· 精致胶囊卡片，图标文字居中对齐不换行 */
.photo-row {
  margin-bottom: 24rpx;
}
.photo-upload {
  width: 100%;
  height: 96rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx dashed rgba(114, 216, 196, 0.5);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  overflow: hidden;
  transition: all 0.2s ease;
}
.photo-upload:active { transform: scale(0.99); background: rgba(114,216,196,0.08); }
.photo-upload.photo-has { border-style: solid; padding: 0; background: transparent; border-color: rgba(114,216,196,0.4); }
.photo-plus { font-size: 30rpx; line-height: 1; }
.photo-label { font-size: 24rpx; color: #4A6A60; font-weight: 600; white-space: nowrap; }
.photo-preview {
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
}
.photo-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #A8BCB6;
  text-align: center;
  line-height: 1.5;
}

/* 手账输入框 */
.drawer-note {
  margin-bottom: 28rpx;
}
.note-input {
  width: 100%;
  min-height: 120rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  font-size: 26rpx;
  color: #1F3833;
  line-height: 1.6;
  box-sizing: border-box;
  border: 2rpx solid rgba(114, 216, 196, 0.3);
}
.note-placeholder { color: #A8BCB6; }

/* 确认按钮 */
.drawer-confirm {
  width: 100%;
  height: 104rpx;
  border: none;
  border-radius: 52rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #6FE0C6 0%, #3EC7A6 55%, #2FA98C 100%);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35),
    0 14rpx 34rpx rgba(56, 192, 160, 0.35);
  position: relative;
  overflow: hidden;
}
/* 左上高光 + 底部柔光，做出细腻立体质感 */
.drawer-confirm::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.28) 0%, rgba(255,255,255,0) 100%);
  border-radius: 52rpx 52rpx 0 0;
  pointer-events: none;
}
.drawer-confirm-ico {
  font-size: 36rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.15));
}
.drawer-confirm-label {
  position: relative;
  z-index: 1;
}
.drawer-confirm::after { border: none; }
.drawer-confirm--press {
  transform: scale(0.98);
  box-shadow:
    inset 0 2rpx 0 rgba(255,255,255,0.2),
    0 6rpx 16rpx rgba(56, 192, 160, 0.3);
}

/* ========== 7. 今日氧气记录入口（顶部醒目按钮） ========== */
.status-bar {
  width: 100%;
  max-width: 640rpx;
  margin: 20rpx auto 8rpx;
  padding: 24rpx 32rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  position: relative;
  z-index: 6;
  /* 未记录态：薄荷绿渐变，醒目可点 */
  background: linear-gradient(135deg, #6FE0C6 0%, #38C0A0 100%);
  box-shadow: 0 10rpx 28rpx rgba(56, 192, 160, 0.4);
  animation: barBreathe 3.2s ease-in-out infinite;
}
.status-bar--press { transform: scale(0.98); }

/* 状态条呼吸光晕 */
@keyframes barBreathe {
  0%, 100% { box-shadow: 0 10rpx 28rpx rgba(56, 192, 160, 0.4); }
  50% { box-shadow: 0 10rpx 40rpx rgba(56, 192, 160, 0.55), 0 0 24rpx rgba(56, 192, 160, 0.35); }
}

.status-bar-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
}
.status-bar-text {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.4;
}
.status-bar-arrow {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  flex-shrink: 0;
  animation: arrowNudge 1.6s ease-in-out infinite;
}
@keyframes arrowNudge {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(6rpx); }
}

/* 已完成态：柔和浅绿，弱化入口感 */
.status-bar--done {
  background: rgba(224, 247, 240, 0.9);
  border: 1.5rpx solid rgba(56, 192, 160, 0.35);
  box-shadow: 0 6rpx 20rpx rgba(56, 192, 160, 0.15);
  animation: none;
}
.status-bar--done .status-bar-icon {
  background: linear-gradient(135deg, #38C0A0, #2BA882);
  color: #fff;
}
.status-bar--done .status-bar-text {
  color: #2B5B52;
  font-weight: 600;
}
.status-bar--done .status-bar-arrow { display: none; }

/* ========== 【面部能量扫描】主入口卡片 ========== */
.mood-snap-card {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  align-items: center;
  margin: 24rpx auto 8rpx;
  padding: 26rpx 26rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2BA882 0%, #1E8E6F 100%);
  box-shadow: 0 10rpx 26rpx rgba(30, 142, 111, 0.32);
  position: relative;
  overflow: hidden;
  z-index: 5;
  transition: transform 0.15s ease;
}
.mood-snap-card::after {
  content: '';
  position: absolute;
  right: -36rpx;
  top: -36rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.14);
}
.mood-snap-card--press { transform: scale(0.97); opacity: 0.92; }
.mood-snap-cam {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.32);
  flex-shrink: 0;
  animation: moodPulse 2.4s ease-in-out infinite;
}
@keyframes moodPulse {
  0%,100% { transform: scale(1); box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.32), 0 0 0 0 rgba(255,255,255,0.4); }
  50% { transform: scale(1.07); box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.32), 0 0 0 16rpx rgba(255,255,255,0); }
}
.mood-snap-mid { flex: 1; display: flex; flex-direction: column; margin-left: 22rpx; }
.mood-snap-title { font-size: 34rpx; font-weight: 700; color: #fff; letter-spacing: 1rpx; }
.mood-snap-sub { margin-top: 6rpx; font-size: 22rpx; color: rgba(255,255,255,0.92); }
.mood-snap-go { font-size: 24rpx; font-weight: 600; color: #fff; }
