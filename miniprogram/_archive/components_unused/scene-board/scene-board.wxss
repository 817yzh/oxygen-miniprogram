/* components/scene-board/scene-board.wxss */

.sboard-head { align-items: center; }

.sboard-list { gap: 20rpx; }

.sboard-card {
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
}
.scene-hover { transform: scale(0.98); opacity: 0.9; }

.sboard-top { align-items: center; gap: 18rpx; }
.sboard-icon {
  width: 72rpx; height: 72rpx;
  background: rgba(114,216,196,0.14);
  border-radius: 20rpx; font-size: 40rpx;
}
.sboard-title { font-size: 30rpx; font-weight: 700; color: #22303C; }
.sboard-desc { font-size: 24rpx; color: #8899A6; margin-top: 4rpx; }

.sboard-oxygen { align-items: center; gap: 16rpx; }
.sboard-ox-label { font-size: 24rpx; color: #4A5568; }
.sboard-stars { font-size: 26rpx; color: #FF9F43; letter-spacing: 2rpx; }

.sboard-rec { align-items: center; gap: 10rpx; }
.sboard-rec-ico { font-size: 26rpx; }
.sboard-rec-text { font-size: 24rpx; color: #2E6B5E; }

.sboard-action {
  justify-content: flex-end;
}
.sboard-action-text { font-size: 26rpx; color: var(--yy-primary); font-weight: 600; }
