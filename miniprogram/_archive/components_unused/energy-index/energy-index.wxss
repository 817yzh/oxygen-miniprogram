.energy-index {
  width: 100%;
}
.ei-item {
  margin-bottom: 14px;
}
.ei-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}
.ei-icon { font-size: 16px; }
.ei-label {
  flex: 1;
  font-size: 14px;
  color: var(--yy-text, #264653);
  font-weight: 600;
}
.ei-value {
  font-size: 14px;
  font-weight: 800;
  color: var(--yy-primary, #72D8C4);
}
.ei-bar {
  height: 8px;
  border-radius: 999px;
  background: rgba(184, 232, 255, 0.3);
  overflow: hidden;
}
.ei-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #72D8C4, #B8E8FF);
  transition: width 0.5s ease;
}
