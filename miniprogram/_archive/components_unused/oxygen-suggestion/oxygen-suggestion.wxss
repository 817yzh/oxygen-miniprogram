/* 今日氧气建议(V0.8) */
.sugg-card { padding: 24rpx; }
.sugg-head { justify-content: space-between; align-items: center; }
.sugg-title { font-size: 16px; font-weight: 700; }
.sugg-main { align-items: flex-start; }
.sugg-icon {
  width: 56rpx; height: 56rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #d8f5ee, #f3fbf8);
  font-size: 30rpx; margin-right: 20rpx; flex-shrink: 0;
}
.sugg-desc { font-size: 15px; font-weight: 600; color: var(--yy-text); }
.sugg-tip { font-size: 12px; color: var(--yy-text-sub); margin-top: 6rpx; line-height: 1.5; }
.sugg-product { margin-top: 10rpx; }
.sugg-prod-tag {
  font-size: 11px; color: var(--yy-primary);
  background: rgba(114,216,196,0.12);
  border-radius: 999px; padding: 4rpx 14rpx;
}
