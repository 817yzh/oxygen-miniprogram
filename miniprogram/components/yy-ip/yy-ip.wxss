/* 氧氧 IP 组件样式 */
.yy-ip {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 尺寸 */
.size-lg { width: 220px; height: 220px; }
.size-md { width: 140px; height: 140px; }
.size-sm { width: 88px; height: 88px; }

/* IP 本体 */
.ip-body {
  width: 100%;
  height: 100%;
  position: relative;
  z-index: 2;
  border-radius: 999px;
}

/* ===== 呼吸光晕 ===== */
.glow {
  position: absolute;
  inset: 0;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(114,216,196,0.35) 0%, rgba(184,232,255,0.05) 70%);
  z-index: 1;
  animation: breathe 3s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { transform: scale(0.94); opacity: 0.85; }
  50% { transform: scale(1.02); opacity: 1; }
}

/* ===== 氧气粒子 ===== */
.particle {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: rgba(184,232,255,0.55);
  z-index: 3;
  opacity: 0;
}
.p1 { top: 6%; left: 20%; animation: floatUp 3.2s ease-in-out infinite; }
.p2 { top: 18%; right: 12%; animation: floatUp 3.8s ease-in-out 0.6s infinite; }
.p3 { top: 40%; left: 8%; animation: floatUp 4.2s ease-in-out 1.2s infinite; }

@keyframes floatUp {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  30% { opacity: 0.9; }
  100% { transform: translateY(-36px) scale(1.15); opacity: 0; }
}

/* ===== 动作差异化 ==== */
.action-celebrate .ip-body {
  animation: bounce 0.9s ease-in-out infinite;
}
@keyframes bounce {
  0%, 100% { transform: translateY(0) scale(1); }
  40% { transform: translateY(-10px) scale(1.05); }
}

.action-wave .ip-body {
  animation: wave 1.6s ease-in-out infinite;
}
@keyframes wave {
  0%, 100% { transform: rotate(0deg); }
  20% { transform: rotate(-6deg); }
  60% { transform: rotate(5deg); }
}

/* welcome = 挥手问候(复用 wave) */
.action-welcome .ip-body {
  animation: wave 1.8s ease-in-out infinite;
}

/* encourage = 鼓励轻跃 */
.action-encourage .ip-body {
  animation: hop 1.2s ease-in-out infinite;
}
@keyframes hop {
  0%, 100% { transform: translateY(0); }
  40% { transform: translateY(-8px) scale(1.04); }
}

.action-detect .glow {
  animation: scan 2s ease-in-out infinite;
}
@keyframes scan {
  0%, 100% { opacity: 0.5; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.06); }
}
.action-detect .ip-body {
  animation: pulse 1.2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

.action-grow .glow {
  background: radial-gradient(circle, rgba(255,159,67,0.35) 0%, rgba(255,192,122,0.08) 70%);
}

/* ===== 旁白气泡 ===== */
.ip-bubble {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255,255,255,0.9);
  border-radius: 16px;
  padding: 6px 14px;
  font-size: 12px;
  color: #333;
  white-space: nowrap;
  box-shadow: 0 4px 16px rgba(114,216,196,0.25);
  border: 1px solid rgba(184,232,255,0.6);
  z-index: 5;
}
.ip-bubble::after {
  content: '';
  position: absolute;
  bottom: -6px;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 6px solid transparent;
  border-right: 6px solid transparent;
  border-top: 7px solid rgba(255,255,255,0.9);
}
