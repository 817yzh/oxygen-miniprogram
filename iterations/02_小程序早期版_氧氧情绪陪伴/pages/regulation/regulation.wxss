/* P5 · 调节内容页样式 */

.regulation-header {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* 场景过滤 */
.scene-tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  white-space: nowrap;
  padding: 2px 0;
}
.scene-tab {
  padding: 8px 14px;
  border-radius: var(--radius-full);
  border: 1px solid var(--border);
  font-size: 13px;
  color: var(--text-secondary);
  background: var(--surface);
  flex-shrink: 0;
  cursor: pointer;
}
.scene-tab.active {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

/* 调节卡片 */
.regulation-card {
  padding: 16px;
}
.card-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}
.card-title {
  font-size: 16px;
  font-weight: 700;
}
.card-tag {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}
.card-desc {
  display: block;
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 12px;
}
.card-desc.tiny {
  font-size: 12px;
}

/* 行动建议 */
.action-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.action-item {
  padding: 14px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.action-number {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 13px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.action-content {
  flex: 1;
  min-width: 0;
}
.action-title {
  font-size: 14px;
  font-weight: 600;
  display: block;
}
.action-desc {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-top: 4px;
  display: block;
}

/* 科普小贴士 */
.tip-card {
  padding: 14px;
}

/* 合规 */
.compliance-note {
  text-align: center;
  padding: 8px 0;
}
.compliance-note .muted.small {
  font-size: 11px;
}
