<!-- P5 · 调节内容页 -->
<view class="page">

  <view class="regulation-header">
    <text class="section-title">调节建议</text>
    <text class="muted">按场景过滤，找到最适合你的调节方式</text>
  </view>

  <!-- 场景过滤 tab -->
  <view class="scene-tabs">
    <view class="scene-tab {{activeScene === 'all' ? 'active' : ''}}" 
      data-scene="all" bindtap="filterScene">全部</view>
    <view class="scene-tab {{activeScene === 'plateau' ? 'active' : ''}}" 
      data-scene="plateau" bindtap="filterScene">🏔️ 高原</view>
    <view class="scene-tab {{activeScene === 'brain' ? 'active' : ''}}" 
      data-scene="brain" bindtap="filterScene">🧠 脑疲劳</view>
    <view class="scene-tab {{activeScene === 'sport' ? 'active' : ''}}" 
      data-scene="sport" bindtap="filterScene">🏃 运动</view>
    <view class="scene-tab {{activeScene === 'elder' ? 'active' : ''}}" 
      data-scene="elder" bindtap="filterScene">💚 银发</view>
  </view>

  <!-- 呼吸引导（4-4-6 已有素材） -->
  <view class="regulation-card card">
    <view class="card-header">
      <text class="card-title">🫧 呼吸氧舱</text>
      <text class="card-tag">推荐</text>
    </view>
    <text class="card-desc">4-4-6 呼吸法。吸气 4 秒 → 屏息 4 秒 → 呼气 6 秒</text>
    <button class="btn-primary small" bindtap="startBreathing">
      {{isBreathing ? '呼吸中...' : '开始 3 轮呼吸'}}
    </button>
  </view>

  <!-- 行动建议清单 -->
  <view class="action-list">
    <text class="section-title">行动建议</text>
    
    <view class="action-item card" wx:for="{{filteredActions}}" wx:key="index">
      <view class="action-number">{{index + 1}}</view>
      <view class="action-content">
        <text class="action-title">{{item.title}}</text>
        <text class="action-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 科普小贴士 -->
  <view class="tip-card card">
    <text class="card-title">💡 氧氧的知识小站</text>
    <text class="card-desc tiny">{{scientificTip}}</text>
  </view>

  <!-- 合规提示 -->
  <view class="compliance-note">
    <text class="muted small">💡 以上建议不构成医疗建议或心理治疗，如有专业需要请咨询医生</text>
  </view>

</view>
