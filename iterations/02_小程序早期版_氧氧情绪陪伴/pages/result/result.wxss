/* P4 · 结果页样式 */

/* 情绪主标 */
.emotion-hero {
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}
.emotion-badge-lg {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.emotion-icon {
  font-size: 48px;
}
.emotion-label-text {
  font-size: 28px;
  font-weight: 800;
  color: var(--text-primary);
}
.confidence-badge {
  padding: 4px 14px;
  border-radius: var(--radius-full);
  background: rgba(115, 88, 69, 0.08);
}
.confidence-text {
  font-size: 12px;
  color: var(--text-secondary);
  font-weight: 600;
}
.confidence-note {
  font-size: 11px;
  text-align: center;
}

/* 趣味画像 */
.persona-card {
  padding: 14px 16px;
  background: linear-gradient(135deg, rgba(53, 214, 184, 0.08), rgba(90, 167, 255, 0.06));
  border-color: rgba(53, 214, 184, 0.2);
}
.persona-line {
  font-size: 16px;
  font-weight: 600;
  text-align: center;
  color: var(--accent);
}

/* 状态解读 */
.insight-card {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.insight-text {
  font-size: 14px;
  line-height: 1.7;
  color: var(--text-primary);
}

/* 调节建议 */
.regulation-card {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.regulation-text {
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-primary);
  padding: 10px 14px;
  background: rgba(53, 214, 184, 0.06);
  border-radius: var(--radius-sm);
}
.btn-primary.small {
  height: 40px;
  font-size: 14px;
}

/* 产品推荐简化版 */
.product-card {
  padding: 14px 16px;
  border-color: rgba(53, 214, 184, 0.25);
  background: linear-gradient(135deg, #f0faf7, #f7fbf5);
}
.product-content {
  display: flex;
  align-items: center;
  gap: 12px;
}
.product-icon {
  font-size: 36px;
  flex: 0 0 auto;
}
.product-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.product-title {
  font-size: 14px;
  font-weight: 700;
}
.product-tip {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 情绪概率分布（拍照识别彩蛋）*/
.distribution-card {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.distribution-bars {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.dist-item {
  display: flex;
  align-items: center;
  gap: 10px;
}
.dist-bar-bg {
  flex: 1;
  height: 18px;
  border-radius: 9px;
  background: rgba(115, 88, 69, 0.08);
  overflow: hidden;
}
.dist-bar-fill {
  height: 100%;
  border-radius: 9px;
  transition: width 0.5s ease;
}
.dist-info {
  width: 80px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6px;
}
.dist-label {
  font-size: 12px;
  color: var(--text-secondary);
}
.dist-label.active {
  color: var(--accent);
  font-weight: 700;
}
.dist-conf {
  font-size: 11px;
  color: var(--accent);
  font-weight: 700;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* 合规声明 */
.compliance {
  text-align: center;
  padding: 8px 0;
}
.compliance .muted.small {
  font-size: 11px;
}
