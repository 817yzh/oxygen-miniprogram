<!-- P2 · 打卡页 -->
<view class="page">

  <!-- 顶部引导 -->
  <view class="guide-section">
    <text class="section-title">现在感觉怎么样？</text>
    <text class="muted">告诉氧氧，它会温柔接住你的感受</text>
  </view>

  <!-- Tab 切换：拍照 / 文字 -->
  <view class="tab-bar">
    <view class="tab-item {{tabMode === 'text' ? 'active' : ''}}" bindtap="switchTab" data-tab="text">
      <text>✏️ 写写此刻</text>
    </view>
    <view class="tab-item {{tabMode === 'camera' ? 'active' : ''}}" bindtap="switchTab" data-tab="camera">
      <text>📷 拍一张</text>
    </view>
  </view>

  <!-- 文字输入模式 -->
  <view class="input-section {{tabMode === 'text' ? '' : 'hidden'}}">
    <textarea class="text-input" 
      placeholder="比如：到拉萨第二天，头疼睡不着……"
      maxlength="200"
      bindinput="onTextInput"
      value="{{userText}}"
      auto-height
    ></textarea>
    <view class="example-tips">
      <text class="tip-label">试试说：</text>
      <view class="tips-row">
        <text class="tip-chip" data-text="加班到凌晨，脑子转不动了" bindtap="useExample">🧠 加班到凌晨</text>
        <text class="tip-chip" data-text="今天跑了10公里，腿好酸" bindtap="useExample">🏃 跑完10公里</text>
      </view>
      <view class="tips-row">
        <text class="tip-chip" data-text="一个人在家感觉很空" bindtap="useExample">💚 一个人在家</text>
        <text class="tip-chip" data-text="马上要进藏了，有点紧张" bindtap="useExample">🏔️ 进藏前紧张</text>
      </view>
    </view>
  </view>

  <!-- 拍照模式 -->
  <view class="camera-section {{tabMode === 'camera' ? '' : 'hidden'}}">
    <view class="camera-area" bindtap="takePhoto">
      <image class="photo-preview" src="{{photoSrc}}" mode="aspectFill" wx:if="{{photoSrc}}"></image>
      <view class="camera-placeholder" wx:else>
        <text class="camera-icon">📷</text>
        <text class="camera-hint">拍下现在的场景</text>
        <text class="camera-subhint">氧氧会从画面感受你的状态</text>
      </view>
    </view>
    <view class="camera-actions" wx:if="{{photoSrc}}">
      <button class="btn-secondary small" bindtap="retakePhoto">重拍</button>
      <button class="btn-primary small" bindtap="usePhoto">使用这张</button>
    </view>
  </view>

  <!-- 场景选择 -->
  <view class="scene-select">
    <text class="section-title">所属场景（选填）</text>
    <view class="scene-chips">
      <view class="scene-chip {{selectedScene === 'plateau' ? 'active' : ''}}" 
        data-scene="plateau" bindtap="pickScene">🏔️ 高原</view>
      <view class="scene-chip {{selectedScene === 'brain' ? 'active' : ''}}" 
        data-scene="brain" bindtap="pickScene">🧠 脑疲劳</view>
      <view class="scene-chip {{selectedScene === 'sport' ? 'active' : ''}}" 
        data-scene="sport" bindtap="pickScene">🏃 运动</view>
      <view class="scene-chip {{selectedScene === 'elder' ? 'active' : ''}}" 
        data-scene="elder" bindtap="pickScene">💚 银发</view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="btn-primary {{canSubmit ? '' : 'disabled'}}" 
      disabled="{{!canSubmit}}" bindtap="submitCheckin">
      让氧氧看看
    </button>
  </view>

  <!-- 隐私提示 — 按打卡模式动态显示 -->
  <view class="privacy-note">
    <text class="muted small" wx:if="{{tabMode === 'text'}}">✏️ 你写的内容仅在本地处理，不会上传</text>
    <text class="muted small" wx:if="{{tabMode === 'camera'}}">📷 照片会上传进行情绪识别，识别完成后不会保存</text>
    <text class="muted small">⚠️ 情绪判断为AI辅助参考，不构成医疗诊断</text>
  </view>

</view>
