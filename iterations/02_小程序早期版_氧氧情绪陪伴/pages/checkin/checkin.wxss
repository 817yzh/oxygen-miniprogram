/* P2 · 打卡页样式 */

.guide-section {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  background: var(--surface);
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  overflow: hidden;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.15s;
}
.tab-item.active {
  background: var(--accent);
  color: #fff;
}

/* 文字输入 */
.input-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.text-input {
  width: 100%;
  min-height: 100px;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-primary);
  box-sizing: border-box;
}
.text-input::placeholder {
  color: var(--text-secondary);
  opacity: 0.6;
}

/* 示例引导 */
.example-tips {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.tip-label {
  font-size: 12px;
  color: var(--text-secondary);
}
.tips-row {
  display: flex;
  gap: 8px;
}
.tip-chip {
  font-size: 12px;
  padding: 6px 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-full);
  color: var(--text-secondary);
  cursor: pointer;
}
.tip-chip:active {
  background: var(--accent-soft);
  border-color: var(--accent-light);
}

/* 拍照区域 */
.camera-section {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.camera-area {
  width: 100%;
  height: 220px;
  border-radius: var(--radius);
  border: 2px dashed var(--border);
  overflow: hidden;
  position: relative;
  cursor: pointer;
}
.photo-preview {
  width: 100%;
  height: 100%;
}
.camera-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 8px;
}
.camera-icon {
  font-size: 40px;
}
.camera-hint {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-secondary);
}
.camera-subhint {
  font-size: 12px;
  color: var(--text-secondary);
  opacity: 0.7;
}
.camera-actions {
  display: flex;
  gap: 10px;
}
.camera-actions .small {
  flex: 1;
  height: 40px;
  font-size: 13px;
}

/* 场景选择 */
.scene-select {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.scene-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.scene-chip {
  padding: 8px 14px;
  border-radius: var(--radius-full);
  border: 1px solid var(--border);
  background: var(--surface);
  font-size: 13px;
  color: var(--text-secondary);
  cursor: pointer;
}
.scene-chip.active {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

/* 提交 */
.submit-section {
  margin-top: 4px;
}
.btn-primary.disabled {
  opacity: 0.45;
}

/* 隐私提示 */
.privacy-note {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 8px 0;
}
.privacy-note .muted.small {
  font-size: 11px;
}

.hidden {
  display: none;
}
